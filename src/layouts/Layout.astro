---
import '../styles/globals.css';
import { AppInit } from '../components/app-init';
import { ScrollProgress } from '../components/scroll-progress';
import ScrollRestoration from '../components/scroll-restoration';
import Header from '../components/Header.astro';
import Interactions from '../components/interactions.astro';
import DitherBg from '../components/dither-bg.astro';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  imageWidth?: number;
  imageHeight?: number;
  theme?: "light" | "dark";
}

const {
  title = "Emiliano Montes | Product Designer and Engineer",
  description = "Portfolio of Emiliano Montes, a product designer and engineer building web and iOS products end to end, from Figma to production.",
  image = "/og.jpg",
  imageAlt = title,
  imageWidth,
  imageHeight,
  theme = "dark",
} = Astro.props;

const pageUrl = new URL(Astro.url.pathname, Astro.site);
const imageUrl = new URL(image, Astro.site);
// The default og.jpg is always 1200x630; other images only report size when the page says so.
const isDefaultImage = image === "/og.jpg";
const width = isDefaultImage ? 1200 : imageWidth;
const height = isDefaultImage ? 630 : imageHeight;
---

<!doctype html>
<html lang="en" class="lenis lenis-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preload" href="/fonts/Geist-Variable.woff2" as="font" type="font/woff2" crossorigin />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={pageUrl.href} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Emiliano Montes" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={pageUrl.href} />
    <meta property="og:image" content={imageUrl.href} />
    <meta property="og:image:alt" content={imageAlt} />
    {width && <meta property="og:image:width" content={String(width)} />}
    {height && <meta property="og:image:height" content={String(height)} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl.href} />
  </head>
  <body class={theme === "light" ? "theme-light" : undefined}>
    <!-- Camaleonic Header -->
    <Header />

    <!-- React Islands for Global Logic -->
    <AppInit client:load />
    <ScrollProgress client:load />
    <ScrollRestoration client:load />

    <!-- Main Content Slot -->
    <slot />

    <!-- Custom cursor + magnetic targets (fine pointers only) -->
    <Interactions />

    <!-- Animated dither texture over every chapter -->
    <DitherBg />

    <!-- SVG Filter for Liquid Texture injected at bottom of body -->
    <svg width="0" height="0" aria-hidden="true" style="position: absolute; pointer-events: none;">
      <filter id="liquid-filter">
        <!-- Reduced numOctaves to 2 for massive CPU performance gain at initial load -->
        <feTurbulence type="fractalNoise" baseFrequency="0.015 0.02" numOctaves="2" result="noise" />
        <feDisplacementMap in="SourceGraphic" in2="noise" scale="30" xChannelSelector="R" yChannelSelector="B" />
      </filter>
    </svg>

    <script>
      import { gsap } from "gsap";
      
      // Liquid breathing effect (SVG Filter animation) optimized
      document.addEventListener("astro:page-load", () => {
        const filter = document.querySelector("#liquid-filter feTurbulence");
        if (filter) {
          const liquidTween = gsap.to(filter, {
            attr: { baseFrequency: "0.01 0.03" },
            duration: 8,
            ease: "sine.inOut",
            yoyo: true,
            repeat: -1,
            paused: true
          });

          const filteredElements = document.querySelectorAll(".hero-section, .bg-image-liquid");
          if ("IntersectionObserver" in window && filteredElements.length > 0) {
            const observer = new IntersectionObserver((entries) => {
              const isVisible = entries.some(entry => entry.isIntersecting);
              if (isVisible) {
                requestAnimationFrame(() => liquidTween.resume());
              } else {
                liquidTween.pause();
              }
            }, { threshold: 0.01 });

            filteredElements.forEach(el => observer.observe(el));
          } else {
            liquidTween.resume();
          }
        }
      });
    </script>
  </body>
</html>
