---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

/*
 * CONTRACT for pages:
 *   <Layout title? description? image? imageAlt? imageWidth? imageHeight?>
 *     ...page content (rendered inside <main id="main">)
 *   </Layout>
 * Layout renders Header and Footer. Pages must not render their own <header>/<footer>.
 * Elements with class "reveal" fade in on scroll (see global.css). Set --i for stagger.
 * window.__lenis exposes the smooth scroller (undefined under reduced motion).
 */

interface Props {
  title?: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  imageWidth?: number;
  imageHeight?: number;
}

const {
  title = "Emiliano Montes | Product Designer and Engineer",
  description = "Portfolio of Emiliano Montes, a product designer and engineer building web and iOS products end to end, from Figma to production.",
  image = "/og.jpg",
  imageAlt = title,
  imageWidth,
  imageHeight,
} = Astro.props;

const pageUrl = new URL(Astro.url.pathname, Astro.site);
const imageUrl = new URL(image, Astro.site);
// The default og.jpg is always 1200x630; other images only report size when the page says so.
const isDefaultImage = image === "/og.jpg";
const width = isDefaultImage ? 1200 : imageWidth;
const height = isDefaultImage ? 630 : imageHeight;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preload" href="/fonts/GeneralSans-Variable.woff2" as="font" type="font/woff2" crossorigin />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={pageUrl.href} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Emiliano Montes" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={pageUrl.href} />
    <meta property="og:image" content={imageUrl.href} />
    <meta property="og:image:alt" content={imageAlt} />
    {width && <meta property="og:image:width" content={String(width)} />}
    {height && <meta property="og:image:height" content={String(height)} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl.href} />

    <!-- Blocking theme script: runs before first paint to avoid a flash. Sets html.js for no-JS-safe reveals. -->
    <script is:inline>
      (function () {
        var root = document.documentElement;
        root.classList.add('js');
        var theme = 'light';
        try {
          var stored = localStorage.getItem('theme');
          if (stored === 'light' || stored === 'dark') {
            theme = stored;
          } else if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
            theme = 'dark';
          }
        } catch (e) {
          if (window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches) theme = 'dark';
        }
        root.setAttribute('data-theme', theme);
      })();
    </script>

    <ClientRouter />
  </head>
  <body>
    <a class="skip-link" href="#main" data-no-inl>Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />

    <script>
      import Lenis from 'lenis';
      import { destroyMotion, initMotion, startScrollClock } from '../lib/motion';

      /*
       * One module for the whole site. Runs once; re-initialises on every client navigation
       * (astro:page-load), tears down before the swap (astro:before-swap).
       * Lenis is driven by gsap.ticker (see startScrollClock), so ScrollTrigger and Lenis share one clock.
       */

      type LenisWindow = Window & { __lenis?: Lenis };
      const w = window as LenisWindow;
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

      let lenis: Lenis | null = null;
      let stopClock: () => void = () => {};
      let revealObserver: IntersectionObserver | null = null;

      function resolveTheme(): 'light' | 'dark' {
        try {
          const stored = localStorage.getItem('theme');
          if (stored === 'light' || stored === 'dark') return stored;
        } catch {
          // Storage blocked: fall through to system preference.
        }
        return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
      }

      function applyTheme(): void {
        document.documentElement.setAttribute('data-theme', resolveTheme());
      }

      function startLenis(): void {
        if (reduceMotion.matches) return;
        lenis = new Lenis({ duration: 1.1 });
        w.__lenis = lenis;
        stopClock = startScrollClock(lenis);
      }

      function stopLenis(): void {
        stopClock();
        stopClock = () => {};
        lenis?.destroy();
        lenis = null;
        w.__lenis = undefined;
      }

      function observeReveals(): void {
        revealObserver?.disconnect();
        revealObserver = null;
        const items = document.querySelectorAll<HTMLElement>('.reveal');
        if (reduceMotion.matches || !('IntersectionObserver' in window)) {
          items.forEach((el) => el.classList.add('is-in'));
          return;
        }
        revealObserver = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue;
              entry.target.classList.add('is-in');
              revealObserver?.unobserve(entry.target);
            }
          },
          { rootMargin: '0px 0px -10% 0px', threshold: 0.01 },
        );
        items.forEach((el) => revealObserver?.observe(el));
      }

      document.addEventListener('astro:before-swap', () => {
        destroyMotion();
        stopLenis();
        revealObserver?.disconnect();
        revealObserver = null;
      });

      // ClientRouter swaps the <html> attributes, so restore the js flag and theme on the new page.
      document.addEventListener('astro:after-swap', () => {
        document.documentElement.classList.add('js');
        applyTheme();
      });

      document.addEventListener('astro:page-load', () => {
        stopLenis();
        startLenis();
        initMotion();
        observeReveals();
      });

      // Follow the system theme live while the user has not chosen one.
      window
        .matchMedia('(prefers-color-scheme: dark)')
        .addEventListener('change', () => {
          let stored: string | null = null;
          try {
            stored = localStorage.getItem('theme');
          } catch {
            // Storage blocked: treat as no stored choice.
          }
          if (stored !== 'light' && stored !== 'dark') applyTheme();
        });
    </script>
  </body>
</html>
