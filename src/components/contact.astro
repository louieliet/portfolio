---
import { personalInfo } from '@/lib/data';
import Button from '@/components/ui/button.astro';
---

<section id="contact" class="min-h-[80vh] flex flex-col justify-center border-t relative overflow-hidden" style="border-color: var(--border-light);">
  
  <div class="absolute inset-0 z-0 opacity-20 mix-blend-overlay pointer-events-none">
    <div class="w-full h-full bg-image-liquid opacity-30 scale-110" style="background: radial-gradient(circle at 50% 50%, var(--bg) 0%, var(--text) 100%);"></div>
  </div>

  <div class="max-w-[100rem] mx-auto w-full px-6 md:px-12 relative z-10 py-32">
    <div class="fade-in max-w-5xl">
      <span class="kicker">Get in touch</span>
      <h2 class="font-display text-6xl md:text-9xl lg:text-[12rem] uppercase tracking-tighter leading-[0.8] mb-12">
        Let's <br/> <span class="opacity-30">Talk.</span>
      </h2>
      <p class="text-2xl md:text-4xl opacity-60 font-medium leading-tight max-w-3xl mb-16">
        If you are looking for a frontend engineer who also understands product design and technical architecture.
      </p>
      
      <Button href={`mailto:${personalInfo.email}`} class="text-lg md:text-xl px-12 py-6">
        Start a conversation
      </Button>
    </div>

    <div class="mt-32 pt-12 border-t flex flex-col gap-12" style="border-color: var(--border-light);">
      {/* Email — own line, it's the longest token */}
      <div>
        <div class="text-xs font-mono uppercase tracking-[0.2em] opacity-40 mb-4">Email</div>
        <a
          href={`mailto:${personalInfo.email}`}
          class="font-display text-xl md:text-3xl hover:opacity-50 transition-opacity uppercase tracking-tight break-all"
        >
          {personalInfo.email}
        </a>
      </div>

      {/* Social links */}
      <div class="flex flex-col md:flex-row gap-8 md:gap-16">
        <div>
          <div class="text-xs font-mono uppercase tracking-[0.2em] opacity-40 mb-4">LinkedIn</div>
          <a
            href={personalInfo.linkedin}
            target="_blank"
            rel="noopener noreferrer"
            class="font-display text-xl md:text-3xl hover:opacity-50 transition-opacity uppercase tracking-tight"
          >
            /in/emiliano-mg
          </a>
        </div>
        <div>
          <div class="text-xs font-mono uppercase tracking-[0.2em] opacity-40 mb-4">GitHub</div>
          <a
            href={personalInfo.github}
            target="_blank"
            rel="noopener noreferrer"
            class="font-display text-xl md:text-3xl hover:opacity-50 transition-opacity uppercase tracking-tight"
          >
            @louieliet
          </a>
        </div>
      </div>

      {/* Meta — own line, can't collide with the links */}
      <div class="pt-8 border-t flex flex-col md:flex-row md:justify-between gap-2 text-xs font-mono uppercase tracking-[0.2em] opacity-30" style="border-color: var(--border-light);">
        <span>{personalInfo.location}</span>
        <span>GMT-6 (CST)</span>
        <span>© {new Date().getFullYear()} {personalInfo.name.split(" ")[0]}</span>
      </div>
    </div>
  </div>
</section>
