---
import { personalInfo } from '@/lib/data';
const year = new Date().getFullYear();
---

<!-- The protected CODE BEAUTY timeline (reveal-scene.astro) tweens `.bg-image-liquid`;
     this hidden node keeps that target resolvable now that the old contact backdrop is gone. -->
<div class="bg-image-liquid" hidden aria-hidden="true"></div>

<footer id="contact" class="contact font-sans">
  <div class="contact-main">
    <h2 class="contact-title">Get in touch</h2>
    <div>
      <a href={`mailto:${personalInfo.email}`}>{personalInfo.email}</a><br />
      {personalInfo.location}
    </div>
  </div>

  <ul class="contact-links" aria-label="Links">
    <li><a href={`mailto:${personalInfo.email}`}>Mail</a></li>
    <li><a href={personalInfo.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn</a></li>
    <li><a href={personalInfo.github} target="_blank" rel="noopener noreferrer">GitHub</a></li>
  </ul>

  <div class="contact-foot mono">
    <span>© {year} {personalInfo.name.split(" ").slice(0, 2).join(" ")}</span>
    <span>{personalInfo.role}</span>
    <span>GMT-6</span>
  </div>
</footer>
