---
import Clock from './Clock.astro';
import { personalInfo } from '../lib/data';

/*
 * Site footer: "Get in touch" copies the email (button) and offers a real mailto link.
 * Links row, then "Now building" on the left and the clock on the right.
 */
const mailto = `mailto:${personalInfo.email}`;
---

<footer class="site-footer bleed">
  <p class="ghost" data-ghost aria-hidden="true">CONTACT</p>
  <div class="col">
    <div class="cta">
      <!-- The label swaps "Copy email" -> "Copied" for 2s; aria-live announces the change. -->
      <button class="get-in-touch t-display" type="button" data-copy-email={personalInfo.email}>
        <span class="cta-text" data-roll="slow">Get in touch</span>
        <span class="copy-label t-mono muted" data-copy-label aria-live="polite">Copy email</span>
      </button>
      <p class="email">
        <a href={mailto}>{personalInfo.email}</a>
      </p>
    </div>

    <ul class="links">
      <li><a href={personalInfo.linkedin} target="_blank" rel="noopener" data-roll-hover>LinkedIn</a></li>
      <li><a href={personalInfo.github} target="_blank" rel="noopener" data-roll-hover>GitHub</a></li>
      <li><a href={mailto} data-roll-hover>Email</a></li>
    </ul>

    <div class="meta">
      <p class="t-mono">
        <span class="muted">Now building:</span>
        <a href="/projects/luma">Luma</a>
      </p>
      <Clock />
    </div>

    <p class="copyright t-mono muted">(c) 2026 Emiliano Montes</p>
  </div>
</footer>

<style>
  .site-footer {
    position: relative;
    overflow: clip;
    border-top: 1px solid var(--line);
    padding-block: clamp(64px, 10vh, 120px) 40px;
  }

  /* Decorative ghost word. It sits behind the content and is cropped by the footer's bottom edge.
   * It is absolutely positioned, so it adds no height. motion.ts scrubs it up into place. */
  .ghost {
    position: absolute;
    left: 0;
    right: 0;
    bottom: -0.14em;
    z-index: 0;
    margin: 0;
    font-family: var(--font-sans);
    font-weight: 600;
    font-size: clamp(120px, 24vw, 420px);
    line-height: 0.8;
    letter-spacing: -0.04em;
    text-align: center;
    text-transform: uppercase;
    white-space: nowrap;
    color: color-mix(in srgb, var(--text) 5%, transparent);
    pointer-events: none;
    user-select: none;
  }

  .site-footer > .col {
    position: relative;
    z-index: 1;
  }

  .get-in-touch {
    display: block;
    text-align: left;
    text-decoration: underline;
    text-decoration-color: transparent;
    text-decoration-thickness: 2px;
    text-underline-offset: 6px;
    transition: text-decoration-color 200ms ease;
  }

  .get-in-touch:hover {
    text-decoration-color: var(--accent);
  }

  /* Inline-block keeps the copy label on the same line as the heading. It inherits the button's underline,
   * because decorations do not pass into inline-block children. */
  .cta-text {
    display: inline-block;
    text-decoration: inherit;
  }

  .copy-label {
    display: inline-block;
    margin-left: 12px;
    vertical-align: middle;
    font-size: 13px;
    letter-spacing: 0.01em;
  }

  .email {
    margin-top: 20px;
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 28px;
    margin-top: 40px;
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 12px 24px;
    margin-top: 64px;
    padding-top: 24px;
    border-top: 1px solid var(--line);
  }

  .copyright {
    margin-top: 40px;
  }
</style>

<script>
  const RESET_MS = 2000;
  let resetTimer: number | undefined;

  // Delegated on document so it survives client navigations.
  document.addEventListener('click', async (event) => {
    const target = event.target as Element | null;
    const button = target?.closest<HTMLButtonElement>('[data-copy-email]');
    if (!button) return;

    const label = button.querySelector<HTMLElement>('[data-copy-label]');
    if (!label) return;

    let message = 'Copied';
    try {
      await navigator.clipboard.writeText(button.dataset.copyEmail ?? '');
    } catch {
      message = 'Copy failed';
    }

    label.textContent = message;
    window.clearTimeout(resetTimer);
    resetTimer = window.setTimeout(() => {
      label.textContent = 'Copy email';
    }, RESET_MS);
  });
</script>
