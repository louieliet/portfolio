---
import AsciiField from './AsciiField.astro';
import RoleWord from './RoleWord.astro';
import { personalInfo } from '../lib/data';

/*
 * Hero: a quiet intro. Content height, not 100dvh, so the first work card peeks into the first
 * viewport at 1440x900. Everything is body size (15px); hierarchy comes from colour, not type scale.
 * The object is the ASCII wave field. The role word is RoleWord, which ends with the period.
 */
---

<section class="col hero">
  <AsciiField />

  <h1 class="name reveal" style="--i:0" aria-label="Emiliano Montes, product designer">Emiliano Montes, <RoleWord /></h1>
  <p class="muted reveal" style="--i:1">{personalInfo.now}</p>
  <p class="muted prev reveal" style="--i:1">{personalInfo.previously}</p>
  <p class="muted bio reveal" style="--i:2">A fun fact <a class="about" href="/about">about me</a>: {personalInfo.funFact}</p>
</section>

<style>
  .hero {
    padding-top: 72px;
  }

  .name {
    margin: 0;
    font-size: 15px;
    font-weight: 400;
    line-height: 1.6;
  }

  .hero p {
    margin: 0;
  }

  .prev {
    margin-top: 2px;
  }

  .bio {
    max-width: 42ch;
    margin-top: 18px;
  }

  .about {
    text-decoration-style: dotted;
    text-decoration-color: var(--text);
    text-underline-offset: 0.25em;
  }
</style>
