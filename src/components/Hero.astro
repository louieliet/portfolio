---
import AsciiField from './AsciiField.astro';
import RoleWord from './RoleWord.astro';
import { personalInfo } from '../lib/data';

/*
 * Hero: a quiet intro. Content height, not 100dvh, so the first work card peeks into the first
 * viewport at 1440x900. Everything is body size (15px); hierarchy comes from colour, not type scale.
 * The object is the ASCII wave field. The role word is RoleWord, which ends with the period.
 */
---

<section class="col hero">
  <AsciiField />

  <h1 class="name" data-roll data-arrive="0.15" aria-label="Emiliano Montes, product designer">Emiliano Montes, <RoleWord /></h1>
  <p class="muted" data-roll data-arrive="0.3">{personalInfo.now}</p>
  <p class="muted prev" data-roll data-arrive="0.3">{personalInfo.previously}</p>
  <p class="muted bio" data-facts={JSON.stringify(personalInfo.funFacts)} data-index="0">
    <button class="fact-label" type="button" data-fact-next aria-controls="fun-fact">A fun fact</button>
    <a class="about" href="/about">about me</a>:
    <span id="fun-fact" class="fact" data-fact data-roll data-arrive="0.4" aria-live="polite">{personalInfo.funFacts[0]}</span>
  </p>
</section>

<script>
  import { swapLines } from '../lib/motion';

  // Delegated on document, so it keeps working after client navigations without re-binding.
  // Each click rotates to the next fact through the line roll; the index lives on the wrapper.
  document.addEventListener('click', (event) => {
    const button = (event.target as Element | null)?.closest<HTMLButtonElement>('[data-fact-next]');
    if (!button) return;
    const wrap = button.closest<HTMLElement>('[data-facts]');
    const fact = wrap?.querySelector<HTMLElement>('[data-fact]');
    if (!wrap || !fact) return;
    const facts = JSON.parse(wrap.dataset.facts ?? '[]') as string[];
    if (facts.length < 2) return;
    const next = (Number(wrap.dataset.index ?? 0) + 1) % facts.length;
    wrap.dataset.index = String(next);
    swapLines(fact, facts[next]);
  });
</script>

<style>
  .hero {
    padding-top: 72px;
  }

  .name {
    margin: 0;
    font-size: 15px;
    font-weight: 400;
    line-height: 1.6;
  }

  .hero p {
    margin: 0;
  }

  .prev {
    margin-top: 2px;
  }

  .bio {
    max-width: 42ch;
    margin-top: 18px;
  }

  /* Block, so the line roll (SplitText lines are blocks) can split it. The fact sits on its own line. */
  .fact {
    display: block;
    margin-top: 4px;
  }

  .about,
  .fact-label {
    text-decoration: underline;
    text-decoration-style: dotted;
    text-decoration-color: var(--text);
    text-underline-offset: 0.25em;
  }
</style>
