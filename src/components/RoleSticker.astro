---
/*
 * RoleSticker: presentational yellow sticker. Hero passes the roles in scene order and owns the timing:
 * its script updates [data-role-label] with the same vertical slide used before.
 * Every role is stacked in the same grid cell as an invisible ghost, so the sticker is always as wide as
 * the longest role and nothing shifts when the text changes.
 * The animated node is aria-hidden; the .sr-only copy of the first role is the stable string for screen readers.
 */
interface Props {
  roles: string[];
}

const { roles } = Astro.props;
const first = roles[0];
---

<span class="sticker">
  <span class="sr-only">{first}</span>
  <span class="window" aria-hidden="true">
    {roles.map((role) => <span class="ghost">{role}</span>)}
    <span class="label" data-role-label>{first}</span>
  </span>
</span>

<style>
  .sticker {
    position: relative;
    display: inline-block;
    vertical-align: middle;
    margin-inline: 0.2em;
    padding: 4px 10px;
    background: var(--accent);
    color: #000;
    font-family: var(--font-sans);
    font-size: 15px;
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    white-space: nowrap;
    transform: rotate(-4deg);
  }

  .window {
    display: inline-grid;
    overflow: hidden;
    vertical-align: top;
  }

  .ghost,
  .label {
    grid-area: 1 / 1;
  }

  .ghost {
    visibility: hidden;
  }

  .label {
    transition:
      transform 260ms var(--ease-out),
      opacity 260ms var(--ease-out);
  }

  .label[data-state='out'] {
    transform: translate3d(0, -100%, 0);
    opacity: 0;
  }

  /* Parked below the window with no transition, so the slide back in is one clean move. */
  .label[data-state='below'] {
    transform: translate3d(0, 100%, 0);
    opacity: 0;
    transition: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .label {
      transition: none;
    }
  }
</style>
