---
/*
 * Media: one image or looping clip.
 * - src ending in .mp4 renders a muted looping <video> with the .webp sibling as poster.
 *   One shared IntersectionObserver plays it only while on screen; never plays under reduced motion.
 * - anything else renders an <img>.
 * - viewTransitionName sets a static view-transition-name inline (the case hero is vt-cover). It also marks the
 *   element data-vt-static, so the card travel can strip it from the page being left (page-transition.ts).
 *
 * Props: { src, alt, class?, loading?: "lazy" | "eager", viewTransitionName? }
 */
interface Props {
  src: string;
  alt: string;
  class?: string;
  loading?: 'lazy' | 'eager';
  viewTransitionName?: string;
}

const { src, alt, class: className, loading = 'lazy', viewTransitionName } = Astro.props;
const isVideo = src.endsWith('.mp4');
const poster = src.replace(/\.mp4$/, '.webp');
const vt = viewTransitionName
  ? { style: `view-transition-name: ${viewTransitionName}`, 'data-vt-static': '' }
  : {};
---

{
  isVideo ? (
    <video
      class:list={['media', className]}
      src={src}
      poster={poster}
      muted
      loop
      playsinline
      preload="none"
      aria-label={alt}
      data-media-video
      {...vt}
    />
  ) : (
    <img class:list={['media', className]} src={src} alt={alt} loading={loading} decoding="async" {...vt} />
  )
}

<style>
  .media {
    display: block;
    width: 100%;
    height: auto;
  }
</style>

<script>
  // Shared playback for every looping clip on the page. Runs on each client navigation.
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
  let observer: IntersectionObserver | null = null;

  function setup(): void {
    observer?.disconnect();
    observer = null;

    const videos = document.querySelectorAll<HTMLVideoElement>('video[data-media-video]');
    // Under reduced motion the poster stays and nothing plays.
    if (!videos.length || reduceMotion.matches || !('IntersectionObserver' in window)) return;

    observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          const video = entry.target as HTMLVideoElement;
          if (entry.isIntersecting) {
            void video.play().catch(() => {
              // Autoplay blocked or aborted: the poster remains.
            });
          } else {
            video.pause();
          }
        }
      },
      { threshold: 0.25 },
    );
    videos.forEach((video) => observer?.observe(video));
  }

  document.addEventListener('astro:page-load', setup);
  document.addEventListener('astro:before-swap', () => {
    observer?.disconnect();
    observer = null;
  });
</script>
