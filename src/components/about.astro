---
import { personalInfo, stack } from '@/lib/data';

const stackSections = [
  { title: "Design & UX", items: stack.design },
  { title: "Frontend", items: stack.frontend },
  { title: "Mobile", items: stack.mobile },
  { title: "Gaming", items: stack.gaming },
  { title: "Backend & Tools", items: stack.backend },
  { title: "Data", items: stack.data },
];
---

<!-- Mask Reveal Scene -->
<section class="about-reveal-scene h-[100dvh] w-full relative overflow-hidden flex flex-col items-center justify-center bg-[#0a0a0a] z-20">
  <div class="reveal-mask absolute inset-0 z-10 flex items-center justify-center pointer-events-none" style="clip-path: polygon(35% 20%, 65% 20%, 65% 80%, 35% 80%);">
    <div class="w-full h-full bg-image-liquid opacity-60 mix-blend-overlay absolute inset-0 z-20 pointer-events-none"></div>
    <img
      src="/projects/me.jpeg"
      alt="Portrait"
      class="reveal-img w-full h-full object-cover mix-blend-luminosity opacity-80 scale-[1.3]"
    />
    <div class="absolute inset-0 bg-gradient-to-t from-black via-black/20 to-transparent z-10"></div>
  </div>
  
  <div class="relative z-20 flex w-full justify-between px-6 md:px-24 pointer-events-none mix-blend-difference overflow-hidden">
    <h2 class="reveal-text-left font-display text-6xl md:text-[10rem] uppercase tracking-tighter text-white">Not just</h2>
    <h2 class="reveal-text-right font-display text-6xl md:text-[10rem] uppercase tracking-tighter text-white">Code.</h2>
  </div>
</section>

<!-- Content Section -->
<section id="about" class="py-32 border-t border-white/10 relative overflow-hidden bg-[#0a0a0a] z-10">
  
  <div class="max-w-[100rem] mx-auto px-6 md:px-12 grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-8">
    
    <!-- Left Column: The Narrative -->
    <div class="lg:col-span-8 lg:col-start-3 space-y-16 fade-in pt-12 lg:pt-24">
      <span class="kicker">The person behind the work</span>
      <div class="space-y-8 text-2xl md:text-4xl leading-[1.3] text-white/80 font-medium max-w-4xl">
        {personalInfo.about.history.split("\n\n").map((paragraph, i) => (
          <p class={i === 0 ? "text-white" : "text-white/50"}>{paragraph}</p>
        ))}
      </div>

      <div class="pt-24 border-t border-white/20 grid grid-cols-1 md:grid-cols-2 gap-16">
        <div>
          <h3 class="font-mono text-sm uppercase tracking-[0.2em] text-white/40 mb-8">Capabilities</h3>
          <div class="space-y-12">
            {stackSections.map((section) => (
              <div>
                <h4 class="font-display text-2xl uppercase tracking-tight mb-4 text-white">
                  {section.title}
                </h4>
                <div class="flex flex-wrap gap-2">
                  {section.items.map((tech) => (
                    <span class="text-xs uppercase font-mono tracking-widest text-white/50 bg-white/5 px-3 py-1">
                      {tech}
                    </span>
                  ))}
                </div>
              </div>
            ))}
          </div>
        </div>

        <div>
          <h3 class="font-mono text-sm uppercase tracking-[0.2em] text-white/40 mb-8">Education</h3>
          <div class="space-y-8">
            {personalInfo.about.education.map((edu) => (
              <div class="group">
                <h4 class="font-display text-xl uppercase tracking-tight text-white mb-2">
                  {edu.degree}
                </h4>
                <div class="text-white/50 font-medium">{edu.institution}</div>
                <div class="text-xs font-mono text-white/30 mt-2">{edu.year}</div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>

  </div>
</section>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  function initAboutAnimations() {
    gsap.registerPlugin(ScrollTrigger);

    const scene = document.querySelector(".about-reveal-scene");
    if (!scene) return;

    const tl = gsap.timeline({
      scrollTrigger: {
        trigger: scene,
        start: "top top",
        end: "+=150%",
        scrub: true,
        pin: true,
        pinSpacing: true,
      }
    });

    // Expand mask to full screen
    tl.to(".reveal-mask", {
      clipPath: "polygon(0% 0%, 100% 0%, 100% 100%, 0% 100%)",
      ease: "none"
    }, 0);

    // Zoom out image
    tl.to(".reveal-img", {
      scale: 1,
      ease: "none"
    }, 0);

    // Slide text to the center (meeting behind the mask)
    tl.fromTo(".reveal-text-left", { x: "-10vw" }, { x: "20vw", ease: "none" }, 0);
    tl.fromTo(".reveal-text-right", { x: "10vw" }, { x: "-20vw", ease: "none" }, 0);
  }

  document.addEventListener("astro:page-load", initAboutAnimations);
  if (document.readyState === "complete") {
    initAboutAnimations();
  } else {
    window.addEventListener("load", initAboutAnimations);
  }
</script>
