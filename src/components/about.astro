---
import { personalInfo, stack } from '@/lib/data';

const stackSections = [
  { title: "Design & UX", items: stack.design },
  { title: "Frontend & Mobile", items: [...stack.frontend, ...stack.mobile] },
  { title: "Systems & Data", items: [...stack.backend, ...stack.data, ...stack.gaming] },
];
---

<section id="about" class="asymmetric-scene bg-[#0a0a0a]">
  {/* 40% Column - Manifesto (Sticky) */}
  <div class="sticky-sidebar">
    <span class="kicker">The Manifesto</span>
    <h2 class="font-display uppercase tracking-tighter leading-[0.85] text-5xl md:text-[5.5rem] mb-6">
      Design.<br />
      Code.<br />
      Data.<br />
      <span class="text-white/30">Systems.</span>
    </h2>
    
    <div class="w-24 md:w-32 aspect-square mt-12 mb-8 relative border border-white/20 filter grayscale contrast-125">
      <img
        src="/projects/me.jpeg"
        alt="Portrait"
        class="w-full h-full object-cover opacity-80"
        loading="lazy"
      />
      <div class="absolute inset-0 bg-white/5 mix-blend-overlay"></div>
    </div>
  </div>

  {/* 60% Column - Content & Capabilities */}
  <div class="brutalist-list pt-0">
    <article class="brutalist-item border-none pb-12 md:pb-24">
      <p class="text-xl md:text-3xl leading-relaxed text-white/80 font-medium max-w-2xl">
        Building products isn't about writing syntax. It's about bridging the gap between complex technical architectures and human intuition. My background spanning game engines, mobile apps, and data systems allows me to engineer interfaces that don't just function—they resonate.
      </p>
    </article>

    {/* Methodologies */}
    <article class="brutalist-item">
      <div class="item-meta flex justify-between mb-8">
        <span>01</span>
        <span>Approach</span>
      </div>
      
      <div class="grid grid-cols-1 md:grid-cols-2 gap-x-12 gap-y-16">
        {personalInfo.about.approach.map((step) => (
          <div class="group">
            <h4 class="font-display text-2xl uppercase tracking-tighter mb-3 flex items-center gap-3">
              <span class="inline-block w-2 h-2 bg-white/30 rounded-full group-hover:bg-white transition-colors duration-300"></span>
              {step.title}
            </h4>
            <p class="text-white/60 leading-relaxed">
              {step.description}
            </p>
          </div>
        ))}
      </div>
    </article>

    {/* Technical Stack */}
    <article class="brutalist-item">
      <div class="item-meta flex justify-between mb-8">
        <span>02</span>
        <span>Capabilities</span>
      </div>
      
      <div class="flex flex-col gap-12">
        {stackSections.map((section) => (
          <div class="border-l border-white/20 pl-6 md:pl-10 relative">
            <div class="absolute -left-[5px] top-1.5 w-[9px] h-[9px] bg-[#0a0a0a] border border-white/40"></div>
            <h4 class="font-mono text-sm uppercase tracking-widest text-white/40 mb-4">
              [ {section.title} ]
            </h4>
            <p class="font-display text-xl md:text-3xl text-white/90 leading-tight max-w-2xl">
              {section.items.join(" · ")}
            </p>
          </div>
        ))}
      </div>
    </article>

    {/* Education */}
    <article class="brutalist-item">
      <div class="item-meta flex justify-between mb-8">
        <span>03</span>
        <span>Education</span>
      </div>
      
      <div class="flex flex-col gap-8">
        {personalInfo.about.education.map((edu) => (
          <div class="grid grid-cols-1 md:grid-cols-[1fr_auto] gap-2 items-baseline border-b border-white/10 pb-6 last:border-0 last:pb-0">
            <h4 class="font-display text-xl md:text-3xl uppercase tracking-tighter text-white">
              {edu.degree}
            </h4>
            <div class="text-right">
              <div class="text-white/60">{edu.institution}</div>
              <div class="text-xs font-mono text-white/30 mt-1 uppercase tracking-widest">{edu.year}</div>
            </div>
          </div>
        ))}
      </div>
    </article>
  </div>
</section>
