---
import { personalInfo } from '@/lib/data';
import Floaters from './floaters.astro';

// Dark chapter (Monolog): one giant statement that reveals word by word with
// scroll; a short bio, portrait and the approach/education index beside it.
const bio = personalInfo.about.history.split("\n\n")[0];
---

<section id="about" class="manifesto font-sans">
  <Floaters />
  <aside class="manifesto-aside">
    <div class="manifesto-portrait" data-clip-mask>
      <img src="/projects/me.jpeg" alt="Portrait of Emiliano Montes" loading="lazy" />
    </div>
    <p>{bio}</p>
    <span class="mono">({personalInfo.location} · GMT-6)</span>
  </aside>

  <div class="manifesto-statement" data-words>
    <p>Good interfaces are felt before they are understood.</p>
    <span class="plus" aria-hidden="true">+</span>
    <p>I design that feeling and build it myself, from the first wireframe to the last frame of motion in production.</p>
  </div>

  <div class="manifesto-grid">
    {personalInfo.about.approach.map((step, i) => (
      <div>
        <span class="mono">0{i + 1}</span>
        <h3>{step.title}</h3>
        <p>{step.description}</p>
      </div>
    ))}
  </div>

  <ul class="manifesto-edu">
    {personalInfo.about.education.map((edu) => (
      <li>
        <span>{edu.degree}</span>
        <span class="mono">{edu.institution} · {edu.year}</span>
      </li>
    ))}
  </ul>
</section>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  import { SplitText } from "gsap/SplitText";

  gsap.registerPlugin(ScrollTrigger, SplitText);

  // Words go from dim to full as the statement crosses the viewport (scrub).
  // Grid and education blocks fade up once; the portrait rises out of a clip mask.
  // Skipped under reduced motion.
  function initManifesto() {
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
    const scene = document.querySelector<HTMLElement>("#about");
    const statement = scene?.querySelector<HTMLElement>("[data-words]");
    if (!scene || !statement) return;

    const ctx = gsap.context(() => {
      document.fonts.ready.then(() => {
        ctx.add(() => {
          const split = SplitText.create(statement.querySelectorAll("p"), { type: "words" });
          gsap.fromTo(split.words, { opacity: 0.18 }, {
            opacity: 1,
            stagger: 0.02,
            ease: "none",
            scrollTrigger: { trigger: statement, start: "top 70%", end: "bottom 45%", scrub: 0.3 },
          });
          ScrollTrigger.refresh();
        });
      });

      gsap.utils.toArray<HTMLElement>(".manifesto-grid > div, .manifesto-edu li, .manifesto-aside > :not([data-clip-mask])", scene).forEach((el) => {
        gsap.fromTo(el, { y: 20, opacity: 0 }, {
          y: 0, opacity: 1, duration: 0.9, ease: "expo.out",
          scrollTrigger: { trigger: el, start: "top 92%", once: true },
        });
      });

      const portrait = scene.querySelector<HTMLElement>("[data-clip-mask]");
      const portraitImg = portrait?.querySelector("img");
      if (portrait && portraitImg) {
        gsap.fromTo(portrait, { clipPath: "inset(100% 0% 0% 0%)" }, {
          clipPath: "inset(0% 0% 0% 0%)", duration: 1.2, ease: "expo.out",
          scrollTrigger: { trigger: portrait, start: "top 85%", once: true },
        });
        gsap.fromTo(portraitImg, { scale: 1.15 }, {
          scale: 1, duration: 1.2, ease: "expo.out",
          scrollTrigger: { trigger: portrait, start: "top 85%", once: true },
        });
      }
    }, scene);

    return () => ctx.revert();
  }

  document.addEventListener("astro:page-load", initManifesto);
  if (document.readyState === "complete") {
    initManifesto();
  } else {
    window.addEventListener("load", initManifesto);
  }
</script>
