---
import Clock from './Clock.astro';
import { personalInfo, projects } from '../lib/data';

/*
 * Fixed top bar, four points: name | clock | nav | theme dot.
 * Nav: Work (home, with project count), About, Resume (external, opens new tab).
 * aria-current="page" marks the active internal link.
 */
const path = Astro.url.pathname;
const onWork = path === '/' || path.startsWith('/projects/');
const onAbout = path === '/about' || path === '/about/';
---

<header class="site-header">
  <div class="bar bleed">
    <a class="name" href="/">Emiliano Montes</a>

    <div class="center">
      <Clock />
    </div>

    <div class="end">
      <nav aria-label="Primary">
        <ul class="nav">
          <li>
            <a href="/#work" aria-current={onWork ? 'page' : undefined}>
              Work<sup>{projects.length}</sup>
            </a>
          </li>
          <li>
            <a href="/about" aria-current={onAbout ? 'page' : undefined}>About</a>
          </li>
          <li>
            <!-- TODO(emiliano): swap for a PDF -->
            <a href={personalInfo.linkedin} target="_blank" rel="noopener">
              Resume<sup aria-hidden="true">+</sup><span class="sr-only"> (opens in a new tab)</span>
            </a>
          </li>
        </ul>
      </nav>

      <button class="theme-toggle" type="button" aria-label="Toggle theme" data-theme-toggle>
        <span class="dot" aria-hidden="true"></span>
      </button>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 50;
    height: var(--header-h);
    background: color-mix(in srgb, var(--bg) 85%, transparent);
    -webkit-backdrop-filter: blur(12px);
    backdrop-filter: blur(12px);
  }

  .bar {
    height: 100%;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 24px;
  }

  .name {
    justify-self: start;
    font-weight: 500;
    color: var(--text);
    text-decoration-color: transparent;
  }

  .center {
    justify-self: center;
  }

  .end {
    justify-self: end;
    display: flex;
    align-items: center;
    gap: 28px;
  }

  .nav {
    display: flex;
    align-items: center;
    gap: 28px;
  }

  .nav a {
    color: var(--muted);
    text-decoration-color: transparent;
  }

  .nav a:hover {
    color: var(--text);
    text-decoration-color: var(--accent);
  }

  .nav a[aria-current='page'] {
    color: var(--text);
  }

  sup {
    font-family: var(--font-mono);
    font-size: 10px;
    line-height: 0;
    vertical-align: super;
    margin-left: 2px;
    color: var(--muted);
  }

  .theme-toggle {
    width: 24px;
    height: 24px;
    display: grid;
    place-items: center;
  }

  .dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--text);
    transition: transform 300ms var(--ease-out);
  }

  .theme-toggle:hover .dot {
    transform: scale(1.3);
  }

  @media (max-width: 719px) {
    .bar {
      grid-template-columns: 1fr auto;
      gap: 16px;
    }

    .center {
      display: none;
    }

    .end {
      gap: 20px;
    }

    .nav {
      gap: 18px;
    }
  }
</style>

<script>
  // Delegated on document, so it keeps working after client navigations without re-binding.
  document.addEventListener('click', (event) => {
    const target = event.target as Element | null;
    if (!target?.closest('[data-theme-toggle]')) return;

    const root = document.documentElement;
    const next = root.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
    root.setAttribute('data-theme', next);
    try {
      localStorage.setItem('theme', next);
    } catch {
      // Storage blocked: the choice applies for this page view only.
    }
  });
</script>
