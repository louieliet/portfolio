---
import { personalInfo } from '@/lib/data';
import { HeroBackground } from './HeroBackground';
---

<section class="hero-section sticky top-0 min-h-[100dvh] w-full z-0 flex flex-col justify-between overflow-hidden text-white px-6 md:px-12 pt-[120px] pb-10" style="background-color: #000000;">

  <!-- Capa Premium WebGL (Fluido Reactivo) -->
  <HeroBackground client:load />

  <!-- TOP ROW -->
  <div class="relative z-10 flex flex-col md:flex-row justify-between items-start w-full gap-8">
    
    <!-- Top Left: Editorial Mark -->
    <div class="hero-anim-top hidden md:flex flex-col gap-2 font-mono text-[11px] uppercase tracking-[0.08em] text-white/50 mt-4">
      <span class="text-white">01/</span>
      <span>From Mexico<br/>With Love</span>
    </div>

    <!-- Top Right: Role -->
    <div class="hero-anim-top flex flex-col items-start md:items-end w-full md:w-auto">
      <h1 class="font-display uppercase leading-[0.85] tracking-[-0.04em] text-left md:text-right" style="font-size: clamp(3.5rem, 9vw, 11rem);">
        <span class="block">Creative</span>
        <span class="block text-white/70">Engineer</span>
      </h1>
    </div>
  </div>

  <!-- BOTTOM ROW -->
  <div class="relative z-10 flex flex-col-reverse md:flex-row justify-between items-end w-full gap-8 mt-12 md:mt-0">
    
    <!-- Bottom Left: Name -->
    <div class="hero-anim-bottom w-full">
      <h2 class="font-display uppercase leading-[0.85] tracking-[-0.04em] text-left" style="font-size: clamp(3.5rem, 12vw, 15rem);">
        <span class="block">{personalInfo.name.split(" ")[0]}</span>
        <span class="block">{personalInfo.name.split(" ")[1]}</span>
      </h2>
    </div>

    <!-- Bottom Right: Meta & Scroll -->
    <div class="hero-anim-bottom flex flex-col items-start md:items-end gap-6 mb-2 md:mb-6 flex-shrink-0">
      <p class="font-sans text-sm md:text-base leading-relaxed max-w-[25ch] text-left md:text-right text-white/60">
        Based in CDMX.<br/>
        Where UX/UI meets motion and code.
      </p>
      
      <div class="flex items-center gap-4 text-[10px] uppercase tracking-[0.25em] font-mono text-white/40">
        <div class="w-12 h-[1px] bg-white/20 relative overflow-hidden">
          <div class="w-full h-full bg-white/80 absolute top-0 left-0 animate-scroll-right"></div>
        </div>
        <span>Scroll</span>
      </div>
    </div>
  </div>
</section>

<style>
  .animate-scroll-right {
    animation: scrollRight 2.5s infinite ease-in-out;
  }
  @keyframes scrollRight {
    0% { transform: translateX(-100%); }
    50% { transform: translateX(0); }
    100% { transform: translateX(100%); }
  }
</style>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  function initHeroAnimations() {
    // Reduced motion: skip GSAP entirely. Content renders in its natural (visible)
    // state and the parallax scrub never registers.
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
      return () => {};
    }

    const ctx = gsap.context(() => {
      // ── Content entrance ───────────────────────────────────────────────────
      const tl = gsap.timeline({ delay: 0.1 });

      tl.fromTo(".hero-anim-top > *",
        { y: 60, opacity: 0 },
        { y: 0, opacity: 1, duration: 1.4, stagger: 0.15, ease: "power4.out" }
      )
      .fromTo(".hero-anim-bottom > *",
        { y: 60, opacity: 0 },
        { y: 0, opacity: 1, duration: 1.4, stagger: 0.15, ease: "power4.out" },
        "-=1.2"
      );

      // ── Parallax out on scroll ─────────────────────────────────────────────
      gsap.to(".hero-section .relative.z-10", {
        y: 150,
        opacity: 0,
        ease: "none",
        scrollTrigger: {
          trigger: ".scrollytelling-scene",
          start: "top bottom",
          end: "top 20%",
          scrub: true,
        }
      });
    });

    return () => ctx.revert();
  }

  document.addEventListener("astro:page-load", initHeroAnimations);
  if (document.readyState === "complete") {
    initHeroAnimations();
  } else {
    window.addEventListener("load", initHeroAnimations);
  }
</script>
