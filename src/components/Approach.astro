---
import { personalInfo } from '../lib/data';

/*
 * Approach: the "How I work" chapter chapter (Story) now sits between the hero and the work on the home. Approach holds the four fact groups from
 * personalInfo.facts (Work, Approach, Drive, Life) as numbered columns, then a link to the about page.
 * Life lines are DUMMY placeholders in data.ts.
 */
---

<section class="col section" aria-label="Approach">

  <ul class="facts">
    {
      personalInfo.facts.map((group, i) => (
        <li class="fact reveal" style={`--i:${i + 1}`}>
          <span class="index t-mono muted">{String(i + 1).padStart(2, '0')}</span>
          <h3 class="title" data-roll>{group.title}</h3>
          <ul class="items muted">
            {group.items.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        </li>
      ))
    }
  </ul>

  <a class="more" href="/about" data-roll-hover>More about me</a>
</section>

<style>
  .facts {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 40px 24px;
  }

  .fact {
    border-top: 1px solid var(--line);
    padding-top: 16px;
  }

  .title {
    margin: 10px 0 12px;
    font-size: 15px;
    font-weight: 500;
    line-height: 1.6;
    color: var(--text);
  }

  .items li + li {
    margin-top: 2px;
  }

  .more {
    display: inline-block;
    margin-top: 40px;
    color: var(--text);
  }

  @media (max-width: 899px) {
    .facts {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 519px) {
    .facts {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
