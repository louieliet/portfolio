---
import { projects } from '../lib/data';

/*
 * WorkStack: the home work list as a perspective card stack.
 * - Each <li> is one project. The tilt is set on the <li> (a direct child of the perspective list), and the
 *   <a> inside it is the card link. The script writes --p (-1 .. 1) per item; CSS turns it into the tilt.
 * - The card closest to the viewport centre is active: accent label bar, aria-current on its index link.
 * - Only the active card's videos play, and only while the stack is on screen, the tab is visible and the card
 *   is at least 60% resolved (desktop) or has resolved (flat).
 * - Each frame has a .stage (the media) and an ASCII canvas on top. The script writes --res next to --p; CSS
 *   settles the media inside the frame (desktop, motion only). See lib/ascii-image.ts.
 * - Desktop (>= 1100px): sticky index in the left gutter.
 * - Under 900px and under reduced motion: flat cards. No-JS: flat cards, fully visible, no canvas.
 * - Opening a card (plain click or Enter): the card's ASCII overlay is cleared and settled, and the card's media,
 *   label name and label bar get view-transition names for the travel (lib/page-transition.ts). The names exist only
 *   during that navigation. After a way back, the card the reader left is settled from its first frame (landing).
 *   With the card travel back, the landing card is also marked data-vt-landing before this script runs, and its
 *   picture is shown from the first frame (see the style block).
 */
const isVideo = (src: string): boolean => src.endsWith('.mp4');
const posterOf = (src: string): string => src.replace(/\.mp4$/, '.webp');
---

<section id="work" class="work" data-work-stack aria-labelledby="work-heading">
  <nav class="index dim" aria-label="Projects">
    <ol>
      {
        projects.map((p, i) => (
          <li>
            <a href={`#work-${p.id}`} data-index-link data-swap>
              <span class="num t-mono">{String(i + 1).padStart(2, '0')}</span>
              {p.name}
            </a>
          </li>
        ))
      }
    </ol>
  </nav>

  <div class="col">
    <header class="head">
      <h2 id="work-heading" class="muted" data-roll>Selected work</h2>
    </header>

    <ol class="stack" data-stack>
      {
        projects.map((p, i) => (
          <li class="item" id={`work-${p.id}`} data-work-item>
            <a
              class="card"
              href={`/projects/${p.id}`}
              aria-label={`${p.name}: ${p.subtitle}`}
              data-card
              data-no-inl
            >
              <span class:list={['frame', `kind-${p.card.kind}`]}>
                <span class="stage">
                  {p.card.media.map((src, j) =>
                    isVideo(src) ? (
                      j === 0 ? (
                        <video
                          class="media"
                          src={src}
                          poster={posterOf(src)}
                          muted
                          loop
                          playsinline
                          preload="none"
                          aria-hidden="true"
                        />
                      ) : (
                        <video
                          class="media"
                          src={src}
                          poster={posterOf(src)}
                          muted
                          loop
                          playsinline
                          preload="none"
                          aria-hidden="true"
                        />
                      )
                    ) : j === 0 ? (
                      <img class="media" src={src} alt="" loading="lazy" decoding="async" />
                    ) : (
                      <img class="media" src={src} alt="" loading="lazy" decoding="async" />
                    )
                  )}
                </span>
                <canvas class="ascii" aria-hidden="true"></canvas>
              </span>
              <span class="label">
                <span class="name roll-cell" data-label-name={p.name}><span class="cell-face">{p.name}</span></span>
                <span class="label-cell">
                  <span class="chips">
                    {p.card.chips.map((chip) => (
                      <span class="chip">{chip}</span>
                    ))}
                  </span>
                  <span class="view">
                    View case
                    <svg width="16" height="10" viewBox="0 0 16 10" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true" focusable="false">
                      <path d="M0 5h14M10 1l4 4-4 4" />
                    </svg>
                  </span>
                </span>
              </span>
            </a>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .work {
    padding-top: clamp(72px, 12vh, 140px);
  }

  /* Gutters: hidden below 1100px, sticky at 40vh inside the section (height 0, so they take no room). */
  .index {
    display: none;
  }

  .head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 20px;
  }

  .head h2 {
    margin: 0;
    font-size: 15px;
    font-weight: 400;
    line-height: 1.6;
  }

  .stack {
    display: flex;
    flex-direction: column;
    gap: clamp(40px, 9vh, 96px);
  }

  /* --v is the smoothed scroll velocity (-1..1), written by the script. Zero at rest. */
  .stack {
    --v: 0;
  }

  /* --p is set by the script. --below and --above split it so CSS can tilt each side on its own. */
  .item {
    --below: max(var(--p, 0), 0);
    --above: max(calc(var(--p, 0) * -1), 0);
    transform-origin: 50% 100%;
  }

  /* Press uses the individual scale property, so it multiplies with the velocity transform on .card. */
  .card {
    display: block;
    color: inherit;
    text-decoration: none;
    transition: scale var(--dur-hover-out) var(--ease-hover);
  }

  @media (prefers-reduced-motion: no-preference) {
    .card:active {
      scale: 0.99;
    }
  }

  .card:focus-visible {
    outline: 2px solid var(--text);
    outline-offset: 4px;
  }

  /* Media frame: 16:10, flat colour, hairline outline, no radius, no shadow. */
  .frame {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: color-mix(in srgb, var(--text) 5%, transparent);
    outline: 1px solid var(--line);
    outline-offset: -1px;
  }

  /* The stage holds the media. It fills the frame, so its height is the frame height (phone screens use 82% of it). */
  .stage {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: scale var(--dur-hover-out) var(--ease-hover);
  }

  /* Hover settle: only a card whose resolve is complete (is-settled, set by the script at RESOLVED, so the ASCII
   * overlay is cleared). scale is the individual property, so it multiplies with the scroll transform. */
  @media (hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference) {
    .item.is-settled .card:hover .stage {
      scale: 1.02;
      transition: scale 600ms var(--ease-hover);
    }
  }

  /* ASCII overlay: the frame's box, transparent except for the cells it paints. Clicks pass through to the link. */
  .ascii {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }

  /* Until the first ASCII frame is painted, the media stays hidden. The class is set by the script only, and
   * the script removes it after the first paint or after a 1.5s failsafe, so a stuck script never hides media. */
  .stack.ascii-pending .stage {
    opacity: 0;
  }

  /* The landing card of a way back (data-vt-landing, set in lib/page-transition.ts) shows its real picture from the
   * first frame: the pending hide is lifted for it, and its ASCII canvas stays off. */
  .stack.ascii-pending [data-vt-landing] .stage {
    opacity: 1;
  }

  [data-vt-landing] .ascii {
    display: none;
  }

  .kind-wide .media {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: cover;
  }

  .kind-phones .media {
    position: relative;
    flex: none;
    width: auto;
    height: 82%;
    max-width: none;
    aspect-ratio: 640 / 1392;
    object-fit: cover;
    outline: 1px solid var(--line);
    outline-offset: -1px;
  }

  .kind-phones .media:nth-child(2) {
    translate: 0 6%;
  }

  /* Label bar: inactive is a quiet bar; active is the one accent on the card. */
  .label {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    margin-top: 5px;
    padding: 9px 12px;
    background: color-mix(in srgb, var(--text) 12%, var(--bg));
    color: var(--text);
    transition:
      background-color 200ms,
      color 200ms;
  }

  /* The label name is a roll cell: the padding keeps descenders inside the clip. */
  .name {
    padding-block: 0.12em;
    margin-block: -0.12em;
    font-size: 20px;
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.2;
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 5px;
  }

  .chip {
    padding: 3px 8px;
    font-size: 12.5px;
    line-height: 1.4;
    background: color-mix(in srgb, var(--text) 22%, var(--bg));
    color: var(--text);
    transition:
      background-color 200ms,
      color 200ms;
  }

  .item.is-active .label {
    background: var(--accent);
    color: #000;
  }

  .item.is-active .chip {
    background: #fff;
    color: #000;
  }

  /* Chips and "View case" share one grid cell. Hover (and focus-visible) slides the chips up and fades them, and
   * slides "View case" in from the left. Text colour inherits from the bar, so active and inactive both work. */
  .label-cell {
    display: grid;
    justify-items: end;
    align-items: center;
    overflow: clip;
    min-width: 0;
  }

  .label-cell > * {
    grid-area: 1 / 1;
    transition:
      transform var(--dur-hover-out) var(--ease-hover),
      opacity var(--dur-hover-out) var(--ease-hover);
  }

  .view {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 14px;
    font-weight: 500;
    letter-spacing: 0;
    white-space: nowrap;
    opacity: 0;
    transform: translateX(-14px);
  }

  .card:focus-visible .chips {
    opacity: 0;
  }

  .card:focus-visible .view {
    opacity: 1;
    transform: none;
  }

  @media (hover: hover) and (pointer: fine) {
    .card:hover .chips {
      opacity: 0;
    }

    .card:hover .view {
      opacity: 1;
      transition: opacity 200ms var(--ease-hover) 40ms, transform 200ms var(--ease-hover) 40ms;
    }
  }

  @media (hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference) {
    .card:hover .chips {
      transform: translateY(-110%);
    }

    .card:hover .view {
      transform: none;
    }
  }

  /* Index hover lights the hovered item; the dimming in global.css mutes its siblings. */
  @media (hover: hover) and (pointer: fine) {
    .index a:hover {
      color: var(--text);
    }
  }

  .num {
    font-size: 12.5px;
  }

  /* Index: active item in --text with an accent dot; the rest muted. */
  .index ol {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .index a {
    position: relative;
    display: flex;
    align-items: center;
    gap: 14px;
    color: var(--muted);
    font-size: 15px;
    line-height: 1.4;
    text-decoration: none;
  }

  .index a[aria-current='true'] {
    color: var(--text);
  }

  .index a[aria-current='true']::after {
    content: '';
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--accent);
  }

  @media (min-width: 900px) {
    .stack {
      perspective: 1400px;
    }
  }

  /* Tilt: below centre leans back from the bottom edge, above centre leans slightly forward from the top. */
  @media (min-width: 900px) and (prefers-reduced-motion: no-preference) {
    .js .item {
      transform: rotateX(calc(var(--below) * 34deg - var(--above) * 12deg)) scale(calc(1 - var(--below) * 0.07));
      opacity: calc(1 - var(--below) * 0.15 - var(--above) * 0.3);
    }

    .js .item[data-side='above'] {
      transform-origin: 50% 0%;
    }
  }

  /* Settle: the media inside the frame moves with the card's position and settles from 1.08x to 1x as the card
   * reaches the centre. The frame clips it (overflow hidden), so the picture slides inside a fixed window. The
   * inner stage is transformed, not the frame, so the view-transition element keeps its start rect. */
  @media (min-width: 900px) and (prefers-reduced-motion: no-preference) {
    .stage {
      transform: translateY(calc(var(--p, 0) * -9%)) scale(calc(1.08 - 0.08 * var(--res, 1)));
    }
  }

  /* Velocity: while scrolling, each card leans up to 6deg and stretches up to 1.5% in Y. Both scale with |--v|
   * and return to exactly flat at rest. Desktop and motion only; will-change is set here and nowhere else. */
  @media (min-width: 900px) and (prefers-reduced-motion: no-preference) {
    .card {
      transform: rotateX(calc(var(--v) * 6deg)) scaleY(calc(1 + max(var(--v), calc(var(--v) * -1)) * 0.015));
      will-change: transform;
    }
  }

  /* Phones: under 900px show two screens; the third is hidden. */
  @media (max-width: 899px) {
    .kind-phones .media:nth-child(n + 3) {
      display: none;
    }
  }

  @media (min-width: 1100px) {
    .index {
      display: block;
      position: sticky;
      top: 40vh;
      width: 220px;
      height: 0;
      margin-left: 56px;
    }
  }
</style>

<script>
  import gsap from 'gsap';
  import type Lenis from 'lenis';
  import { rollText, scrollEnergy } from '../lib/motion';
  import { beginTravel, isPlainActivation, travelAllowed } from '../lib/page-transition';
  import {
    backingRatio,
    cellHashes,
    drawCover,
    easeOut,
    gridFor,
    paintAscii,
    resolveAmount,
    sampleLuminance,
    type Grid,
    type Palette,
  } from '../lib/ascii-image';

  /*
   * Work stack controller. One scroll handler: Lenis when present, plus window scroll and resize as the
   * fallback, batched in one animation frame. Reads all geometry first, then writes.
   * Init on astro:page-load, full teardown on astro:before-swap.
   *
   * ASCII resolve (not under reduced motion). Each frame's canvas paints the cover as characters and dissolves to
   * the real media as the card nears the centre. The maths is in lib/ascii-image.ts.
   * - Desktop (>= 900px): the resolve amount comes from the card's position, the same value written to --res.
   * - Under 900px (flat cards): each card resolves once, over about 700ms, when 35% of it enters the viewport.
   *   Then its canvas is cleared for good.
   * Until the first frame is painted, the stack carries .ascii-pending (media hidden). The script removes it
   * after the first paint, or after a failsafe delay.
   */

  type LenisWindow = Window & { __lenis?: Lenis };

  const DESKTOP_QUERY = '(min-width: 900px)';
  const REDUCE_QUERY = '(prefers-reduced-motion: reduce)';
  const SCHEME_QUERY = '(prefers-color-scheme: dark)';
  const VIDEO_RESOLVE = 0.6; // a card's video plays only once its resolve amount is above this
  const RESOLVE_STEPS = 60; // a card repaints only when its resolve amount moves by 1/60
  const FLAT_RESOLVE_MS = 700;
  const FLAT_ENTER = 0.35; // share of a flat card that must be in view to start its one-time resolve
  const PENDING_FAILSAFE_MS = 1500;
  const PHONE_SHIFT = 0.06; // mirrors `.kind-phones .media:nth-child(2) { translate: 0 6% }` above
  const SETTLED_RESOLVE = 0.999; // the threshold where ascii-image.ts clears the overlay (RESOLVED)
  const FINE_QUERY = '(hover: hover) and (pointer: fine)';
  const PILL_OFFSET = 14; // px from the pointer, on both axes
  const PILL_LERP = 0.18; // per frame, while the pointer is over a card's media

  interface Source {
    el: HTMLElement;
    img: HTMLImageElement;
    index: number; // position among the stage's children (the phones offset depends on it)
  }

  interface AsciiCard {
    item: HTMLElement;
    frame: HTMLElement | null;
    canvas: HTMLCanvasElement | null;
    videos: HTMLVideoElement[];
    index: number;
    sources: Source[];
    ctx: CanvasRenderingContext2D | null;
    grid: Grid | null;
    lum: Float32Array | null;
    hashes: Float32Array | null;
    width: number; // CSS size at the last sample
    height: number;
    ascii: boolean; // sampled and drawable
    landing: boolean; // the card the reader came back to from a case page: real picture from the first frame
    res: number; // resolve amount: 0 is all ASCII, 1 is the real media
    step: number; // last painted resolve step (0..60), -1 = never painted
    flat: 'waiting' | 'running' | 'done';
    start: number; // performance.now() when the flat resolve started
  }

  let cleanups: Array<() => void> = [];

  function teardown(): void {
    for (const fn of cleanups) fn();
    cleanups = [];
  }

  function clamp(value: number, min: number, max: number): number {
    return Math.min(max, Math.max(min, value));
  }

  function headerOffset(): number {
    const value = parseFloat(getComputedStyle(document.documentElement).getPropertyValue('--header-h'));
    return -(Number.isFinite(value) ? value : 0);
  }

  function loadImage(url: string): Promise<HTMLImageElement | null> {
    return new Promise((resolve) => {
      const img = new Image();
      img.onload = () => resolve(img);
      img.onerror = () => resolve(null);
      img.src = url;
    });
  }

  /** The image behind a media element: the poster of a video, or the image itself. */
  function sourceUrl(el: HTMLElement): string | null {
    if (el instanceof HTMLVideoElement) return el.getAttribute('poster');
    if (el instanceof HTMLImageElement) return el.src || null;
    return null;
  }

  function readPalette(): Palette {
    const style = getComputedStyle(document.documentElement);
    return {
      bg: style.getPropertyValue('--bg').trim() || '#0b0c0b',
      fg: style.getPropertyValue('--text').trim() || '#ededed',
      font: style.getPropertyValue('--font-mono').trim() || 'monospace',
      inverted: style.getPropertyValue('color-scheme').trim() === 'light',
    };
  }

  /** Drops a card's ASCII state and releases its canvas memory. The card then shows the real media. */
  function clearCard(card: AsciiCard): void {
    card.ascii = false;
    card.ctx = null;
    card.grid = null;
    card.lum = null;
    card.hashes = null;
    if (card.canvas) {
      card.canvas.width = 0;
      card.canvas.height = 0;
    }
  }

  function mount(root: HTMLElement, reduce: boolean): void {
    const items = Array.from(root.querySelectorAll<HTMLElement>('[data-work-item]'));
    const indexLinks = Array.from(root.querySelectorAll<HTMLAnchorElement>('[data-index-link]'));
    const labels = items.map((item) => item.querySelector<HTMLElement>('[data-label-name]'));
    const stack = root.querySelector<HTMLElement>('[data-stack]');
    if (items.length === 0 || !stack) return;

    const landingItem = document.documentElement.dataset.vtReturn ? `work-${document.documentElement.dataset.vtReturn}` : null;
    const cards: AsciiCard[] = items.map((item, index) => ({
      item,
      frame: item.querySelector<HTMLElement>('.frame'),
      canvas: item.querySelector<HTMLCanvasElement>('canvas.ascii'),
      videos: Array.from(item.querySelectorAll<HTMLVideoElement>('video')),
      index,
      sources: [],
      ctx: null,
      grid: null,
      lum: null,
      hashes: null,
      width: 0,
      height: 0,
      ascii: false,
      landing: item.id === landingItem,
      res: 0,
      step: -1,
      flat: 'waiting',
      start: 0,
    }));

    // Mode is fixed at mount. A breakpoint or motion change remounts the stack (see the listeners below).
    const desktop = window.matchMedia(DESKTOP_QUERY).matches;
    const tilt = !reduce && desktop; // scroll drives the resolve
    const flat = !reduce && !desktop; // each card resolves once

    let active = -1;
    let focused = -1;
    let inView = false;
    let frame = 0; // scroll rAF
    let tickFrame = 0; // flat resolve rAF
    let playbackDirty = false;
    let alive = true;
    let ready = false;
    let palette: Palette = readPalette();
    let flatObserver: IntersectionObserver | null = null;
    let resizer: ResizeObserver | null = null;

    const listen = (target: EventTarget, type: string, fn: EventListener, options?: AddEventListenerOptions): void => {
      target.addEventListener(type, fn, options);
      cleanups.push(() => target.removeEventListener(type, fn, options));
    };

    const reveal = (): void => {
      stack.classList.remove('ascii-pending');
    };

    // Only the active card's clips play, and only while the stack is on screen and the tab is visible. A card
    // with ASCII plays only once it is past the resolve threshold, so a clip never runs hidden behind characters.
    const syncPlayback = (): void => {
      const allowed = !reduce && inView && !document.hidden;
      cards.forEach((card, i) => {
        const live = allowed && i === active && (!card.ascii || card.res > VIDEO_RESOLVE);
        for (const video of card.videos) {
          if (live) {
            if (video.paused) void video.play().catch(() => undefined);
          } else {
            video.pause();
          }
        }
      });
    };

    const setActive = (next: number): void => {
      const prev = active;
      if (active >= 0) {
        cards[active].item.classList.remove('is-active');
        indexLinks[active]?.removeAttribute('aria-current');
      } else {
        // First activation: a way back may have set is-active on the landing card, which is not always the nearest.
        for (const card of cards) card.item.classList.remove('is-active');
      }
      active = next;
      cards[next].item.classList.add('is-active');
      indexLinks[next]?.setAttribute('aria-current', 'true');

      // The newly active card's label rolls once.
      const label = labels[next];
      if (label && prev >= 0) rollText(label, label.dataset.labelName ?? '', 1, true);
      syncPlayback();
    };

    // is-settled: the card's resolve has reached the threshold where its ASCII overlay is cleared. The hover settle
    // in CSS keys off this class, so the picture never scales while characters are still on top of it.
    const setSettled = (card: AsciiCard, settled: boolean): void => {
      if (card.item.classList.contains('is-settled') !== settled) card.item.classList.toggle('is-settled', settled);
    };

    const setResolve = (card: AsciiCard, res: number): void => {
      if ((res > VIDEO_RESOLVE) !== (card.res > VIDEO_RESOLVE)) playbackDirty = true;
      card.res = res;
    };

    // Paints one card at resolve amount `res`, but only when its quantised step changed. Every caller is rAF-driven
    // (scroll handler, flat tween), so nothing paints while the tab is hidden; the one-time prepare paint still runs.
    const drawCard = (card: AsciiCard, res: number): void => {
      if (!card.ascii || !card.ctx || !card.grid || !card.lum || !card.hashes) return;
      const step = Math.round(clamp(res, 0, 1) * RESOLVE_STEPS);
      if (step === card.step) return;
      card.step = step;
      paintAscii(card.ctx, card.grid, card.lum, card.hashes, step / RESOLVE_STEPS, palette);
    };

    const redrawAll = (): void => {
      for (const card of cards) drawCard(card, card.res);
    };

    const loadSources = async (card: AsciiCard): Promise<void> => {
      const { frame: cardFrame } = card;
      if (!cardFrame) return;
      const media = Array.from(cardFrame.querySelectorAll<HTMLElement>('.stage > .media'));
      const phones = cardFrame.classList.contains('kind-phones');
      // Wide cards use their first media. Phones cards use every visible screen (the composite).
      const chosen = phones ? media.filter((el) => el.offsetWidth > 0) : media.slice(0, 1);
      const loaded = await Promise.all(
        chosen.map(async (el): Promise<Source | null> => {
          const url = sourceUrl(el);
          const img = url ? await loadImage(url) : null;
          return img ? { el, img, index: media.indexOf(el) } : null;
        }),
      );
      card.sources = loaded.filter((source): source is Source => source !== null);
    };

    // Samples one card at its current CSS size. Phones: the screens are drawn at their DOM offsets (offset*
    // ignores the transform, so the stage's motion does not skew the sample).
    const sampleCard = (card: AsciiCard): void => {
      clearCard(card);
      const { frame: cardFrame, canvas } = card;
      if (!cardFrame || !canvas || card.sources.length === 0) return;
      const width = cardFrame.clientWidth;
      const height = cardFrame.clientHeight;
      if (width === 0 || height === 0) return;

      const grid = gridFor(width, height);
      const phones = cardFrame.classList.contains('kind-phones');
      const scaleX = grid.cols / width;
      const scaleY = grid.rows / height;
      const lum = sampleLuminance(grid, (ctx) => {
        if (!phones) {
          drawCover(ctx, card.sources[0].img, 0, 0, grid.cols, grid.rows, width / height);
          return;
        }
        for (const source of card.sources) {
          const el = source.el;
          if (el.offsetWidth === 0) continue;
          const shift = source.index === 1 ? PHONE_SHIFT * el.offsetHeight : 0;
          drawCover(
            ctx,
            source.img,
            el.offsetLeft * scaleX,
            (el.offsetTop + shift) * scaleY,
            el.offsetWidth * scaleX,
            el.offsetHeight * scaleY,
            el.offsetWidth / el.offsetHeight,
          );
        }
      });
      if (!lum) return;

      const ratio = backingRatio(width, window.devicePixelRatio || 1);
      canvas.width = Math.round(width * ratio);
      canvas.height = Math.round(height * ratio);
      const ctx = canvas.getContext('2d');
      if (!ctx) return;
      ctx.setTransform(canvas.width / width, 0, 0, canvas.height / height, 0, 0);
      card.ctx = ctx;
      card.grid = grid;
      card.lum = lum;
      card.hashes = cellHashes(grid, card.index);
      card.width = width;
      card.height = height;
      card.step = -1;
      card.ascii = true;
    };

    const update = (): void => {
      frame = 0;
      if (!alive) return;
      const vh = window.innerHeight;
      const mid = vh / 2;

      // Read pass: every card's geometry first.
      const centres = cards.map(({ item }) => {
        const rect = item.getBoundingClientRect();
        return { y: rect.top + rect.height / 2, visible: rect.bottom > 0 && rect.top < vh };
      });
      const ps = centres.map(({ y }) => clamp((y - mid) / vh, -1, 1));

      // Write pass.
      let nearest = 0;
      ps.forEach((p, i) => {
        if (Math.abs(p) < Math.abs(ps[nearest])) nearest = i;
        const card = cards[i];
        card.item.style.setProperty('--p', p.toFixed(3));
        card.item.dataset.side = p >= 0 ? 'below' : 'above';
        if (tilt) {
          const res = card.landing ? 1 : resolveAmount(p);
          card.item.style.setProperty('--res', res.toFixed(3));
          setSettled(card, res >= SETTLED_RESOLVE);
          setResolve(card, res);
          // Far off screen cards are not painted. They repaint when they come back on screen.
          if (centres[i].visible) drawCard(card, res);
        }
      });

      // A focused card counts as active, so keyboard users see the same state as pointer users.
      const next = focused >= 0 ? focused : nearest;
      if (next !== active) setActive(next);

      if (playbackDirty) {
        playbackDirty = false;
        syncPlayback();
      }
    };

    const schedule = (): void => {
      if (frame === 0) frame = requestAnimationFrame(update);
    };

    // Flat cards (under 900px): one resolve per card, started when it is 35% in view.
    const tick = (): void => {
      tickFrame = 0;
      if (!alive) return;
      const now = performance.now();
      let running = false;
      for (const card of cards) {
        if (card.flat !== 'running') continue;
        const t = Math.min(1, (now - card.start) / FLAT_RESOLVE_MS);
        const res = easeOut(t);
        setResolve(card, res);
        drawCard(card, res);
        if (t >= 1) {
          card.flat = 'done';
          setSettled(card, true);
        }
        else running = true;
      }
      if (playbackDirty) {
        playbackDirty = false;
        syncPlayback();
      }
      if (running) tickFrame = requestAnimationFrame(tick);
    };

    const onFlatEnter = (entries: IntersectionObserverEntry[]): void => {
      for (const entry of entries) {
        const card = cards.find((c) => c.frame === entry.target);
        if (!card || card.flat !== 'waiting' || !card.ascii || entry.intersectionRatio < FLAT_ENTER) continue;
        card.flat = 'running';
        card.start = performance.now();
        flatObserver?.unobserve(entry.target);
        if (tickFrame === 0) tickFrame = requestAnimationFrame(tick);
      }
    };

    const onTheme = (): void => {
      palette = readPalette();
      for (const card of cards) card.step = -1;
      redrawAll();
    };

    const prepare = async (): Promise<void> => {
      await document.fonts.ready;
      await Promise.all(cards.map(loadSources));
      if (!alive) return;

      cards.forEach(sampleCard);
      for (const card of cards) {
        if (!card.landing) continue;
        clearCard(card);
        setSettled(card, true);
      }
      palette = readPalette();
      update(); // positions and resolve amounts for every card
      redrawAll(); // paints every card, including the ones off screen, before the first reveal
      ready = true;

      if (flat && alive) {
        flatObserver = new IntersectionObserver(onFlatEnter, { threshold: FLAT_ENTER });
        for (const card of cards) if (card.ascii && card.frame) flatObserver.observe(card.frame);
      }

      resizer = new ResizeObserver(() => {
        if (!alive || !ready) return;
        for (const card of cards) {
          const cardFrame = card.frame;
          if (!cardFrame || !card.ascii) continue;
          if (cardFrame.clientWidth !== card.width || cardFrame.clientHeight !== card.height) sampleCard(card);
        }
        redrawAll();
        schedule();
      });
      for (const card of cards) if (card.frame) resizer.observe(card.frame);

      reveal();
      syncPlayback();
    };

    listen(window, 'scroll', schedule, { passive: true });
    listen(window, 'resize', schedule, { passive: true });
    const lenis = (window as LenisWindow).__lenis;
    if (lenis) {
      lenis.on('scroll', schedule);
      cleanups.push(() => lenis.off('scroll', schedule));
    }

    listen(root, 'focusin', (event) => {
      focused = cards.findIndex(({ item }) => item.contains(event.target as Node));
      schedule();
    });
    listen(root, 'focusout', () => {
      focused = -1;
      schedule();
    });

    const io = new IntersectionObserver(
      (entries) => {
        const last = entries[entries.length - 1];
        if (!last) return;
        inView = last.isIntersecting;
        syncPlayback();
      },
      { threshold: 0 },
    );
    io.observe(stack);
    cleanups.push(() => io.disconnect());
    listen(document, 'visibilitychange', () => {
      syncPlayback();
      schedule();
    });

    // Opening a card. Capture phase: it runs before ClientRouter prepares the navigation, and never prevents default.
    // The card is shown as its real picture (overlay cleared, settled), then the travel names are set.
    listen(
      root,
      'click',
      (event) => {
        const mouse = event as MouseEvent;
        if (!isPlainActivation(mouse) || !travelAllowed()) return;
        const link = (mouse.target as Element | null)?.closest<HTMLAnchorElement>('a[data-card]');
        const card = link ? cards.find(({ item }) => item.contains(link)) : undefined;
        if (!link || !card) return;
        clearCard(card);
        setSettled(card, true);
        card.item.style.setProperty('--res', '1');
        const cover = card.item.querySelector<HTMLElement>('.stage > .media');
        beginTravel(link.href, {
          cover,
          title: labels[card.index],
          bar: card.item.querySelector<HTMLElement>('.label'),
          video: cover instanceof HTMLVideoElement ? cover : null,
        });
      },
      { capture: true },
    );

    indexLinks.forEach((link, i) => {
      listen(link, 'click', (event) => {
        event.preventDefault();
        const target = items[i];
        const lenisNow = (window as LenisWindow).__lenis;
        if (lenisNow) {
          lenisNow.scrollTo(target, { offset: headerOffset() });
        } else {
          target.scrollIntoView({ behavior: reduce ? 'auto' : 'smooth', block: 'start' });
        }
      });
    });

    // Cursor label: one shared pill, over the card media only. Fine pointers and motion only, never on touch. It is
    // lerped in a rAF loop that runs only while the pointer moves or the pill is still catching up. It hides on
    // pointerleave, on any scroll (the next pointermove shows it again) and on teardown.
    if (!reduce && window.matchMedia(FINE_QUERY).matches) {
      const pill = document.createElement('div');
      pill.className = 'cursor-pill';
      pill.setAttribute('aria-hidden', 'true');
      pill.textContent = 'View case';
      document.body.append(pill);
      cleanups.push(() => pill.remove());

      let pillX = 0;
      let pillY = 0;
      let targetX = 0;
      let targetY = 0;
      let pillFrame = 0;
      let pillOn = false;

      const setPill = (on: boolean): void => {
        pillOn = on;
        pill.toggleAttribute('data-on', on);
      };
      const pillLoop = (): void => {
        pillX += (targetX - pillX) * PILL_LERP;
        pillY += (targetY - pillY) * PILL_LERP;
        pill.style.transform = `translate(${pillX.toFixed(2)}px, ${pillY.toFixed(2)}px)`;
        const moving = Math.abs(targetX - pillX) > 0.3 || Math.abs(targetY - pillY) > 0.3;
        pillFrame = moving ? requestAnimationFrame(pillLoop) : 0;
      };

      for (const card of cards) {
        const media = card.frame;
        if (!media) continue;
        listen(media, 'pointerenter', (event) => {
          if ((event as PointerEvent).pointerType === 'touch') return;
          setPill(true);
        });
        listen(media, 'pointermove', (event) => {
          const pointer = event as PointerEvent;
          if (pointer.pointerType === 'touch') return;
          targetX = pointer.clientX + PILL_OFFSET;
          targetY = pointer.clientY + PILL_OFFSET;
          if (!pillOn) {
            // First frame of a visit: start at the pointer, so the pill does not fly in from the last card.
            pillX = targetX;
            pillY = targetY;
            setPill(true);
          }
          if (!pillFrame) pillFrame = requestAnimationFrame(pillLoop);
        });
        listen(media, 'pointerleave', () => setPill(false));
      }
      listen(window, 'scroll', () => setPill(false), { passive: true });
      cleanups.push(() => {
        cancelAnimationFrame(pillFrame);
        pillFrame = 0;
        pillOn = false;
      });
    }

    // Stack velocity: the smoothed scroll velocity from motion.ts becomes --v on the list whenever it changes.
    // It is exactly 0 at rest, so every card settles flat.
    let lastV = 0;
    const writeVelocity = (): void => {
      const v = scrollEnergy();
      if (v === lastV) return;
      lastV = v;
      stack.style.setProperty('--v', v.toFixed(3));
    };
    gsap.ticker.add(writeVelocity);
    cleanups.push(() => {
      gsap.ticker.remove(writeVelocity);
      stack.style.removeProperty('--v');
    });

    if (!reduce) {
      stack.classList.add('ascii-pending');
      const failsafe = window.setTimeout(reveal, PENDING_FAILSAFE_MS);
      listen(window.matchMedia(SCHEME_QUERY), 'change', onTheme);
      const themeObserver = new MutationObserver(onTheme);
      themeObserver.observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });
      cleanups.push(() => {
        clearTimeout(failsafe);
        themeObserver.disconnect();
        stack.classList.remove('ascii-pending');
      });
      prepare().catch(reveal);
    }

    update();

    cleanups.push(() => {
      alive = false;
      cancelAnimationFrame(frame);
      frame = 0;
      cancelAnimationFrame(tickFrame);
      tickFrame = 0;
      flatObserver?.disconnect();
      resizer?.disconnect();
      for (const card of cards) {
        clearCard(card);
        card.sources = [];
        card.item.classList.remove('is-settled');
        for (const video of card.videos) video.pause();
      }
    });
  }

  function init(): void {
    teardown();
    const reduce = window.matchMedia(REDUCE_QUERY).matches;
    document.querySelectorAll<HTMLElement>('[data-work-stack]').forEach((root) => mount(root, reduce));
  }

  // Tilt, flat and reduced motion are decided at mount. A breakpoint or motion change remounts the stack.
  for (const query of [DESKTOP_QUERY, REDUCE_QUERY]) {
    window.matchMedia(query).addEventListener('change', () => init());
  }

  document.addEventListener('astro:page-load', init);
  document.addEventListener('astro:before-swap', teardown);
</script>
