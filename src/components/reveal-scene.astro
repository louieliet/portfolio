---
// src/components/reveal-scene.astro
---

<section class="scrollytelling-scene" id="reveal" aria-label="Creative philosophy">
  <div class="pin-container">
    <div class="split-text">
      <span class="text-left">ENGINEERING</span>
      <div class="image-mask">
        <img
          src="https://images.unsplash.com/photo-1618005182384-a83a8bd57fbe?q=76&w=1400&auto=format&fit=crop"
          srcset="
            https://images.unsplash.com/photo-1618005182384-a83a8bd57fbe?q=72&w=800&auto=format&fit=crop 800w,
            https://images.unsplash.com/photo-1618005182384-a83a8bd57fbe?q=76&w=1400&auto=format&fit=crop 1400w,
            https://images.unsplash.com/photo-1618005182384-a83a8bd57fbe?q=78&w=2200&auto=format&fit=crop 2200w
          "
          sizes="100vw"
          width="1400"
          height="933"
          alt="Abstract interface texture" 
          class="bg-image-liquid"
          loading="lazy"
          decoding="async"
        />
      </div>
      <span class="text-right">THE EXPERIENCE</span>
    </div>
    <p class="pin-caption absolute bottom-[8vh] text-center font-mono text-sm md:text-base text-white/50 max-w-[45ch] opacity-0 z-10 will-change-[transform,opacity]">
      Because scalable code doesn't matter if the interface is frustrating to use.
    </p>
  </div>
</section>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  function initRevealScene() {
    gsap.registerPlugin(ScrollTrigger);

    const pinScene = document.querySelector(".scrollytelling-scene");
    if (!pinScene) return;

    // We use fromTo for the mask to strictly lock its start state and avoid jitter
    const tl = gsap.timeline({
      scrollTrigger: {
        trigger: pinScene,
        start: "top top",
        end: "+=180%", // Pinned for 1.8 viewport heights
        scrub: 0.8, // Slight smoothing for the scrub
        pin: true,
        pinSpacing: true, // Let GSAP handle the padding naturally
      }
    });

    // Single, unified expansion block. Everything happens together.
    tl.fromTo(".image-mask", 
      { clipPath: "inset(20% 35% 20% 35%)" },
      { clipPath: "inset(0% 0% 0% 0%)", duration: 2, ease: "power2.inOut" },
      0 // The '0' forces this to start at the exact beginning of the timeline
    )
    
    // Image dolly zoom (scale down as mask opens)
    .fromTo(".bg-image-liquid", 
      { scale: 1.5 },
      { scale: 1, duration: 2, ease: "power2.inOut" },
      0
    )
    
    // Text collision moving outward
    .fromTo(".text-left", 
      { x: "0vw" },
      { x: "-22vw", duration: 2, ease: "power2.inOut" },
      0
    )
    .fromTo(".text-right", 
      { x: "0vw" },
      { x: "22vw", duration: 2, ease: "power2.inOut" },
      0
    )
    
    // Caption fades in at the very end of the sequence
    .fromTo(".pin-caption", 
      { opacity: 0, y: 20 },
      { opacity: 1, y: 0, duration: 0.4, ease: "power2.out" },
      1.6 // Starts right before the expansion finishes
    );
  }

  // Support Astro View Transitions
  document.addEventListener("astro:page-load", initRevealScene);
  if (document.readyState === "complete") {
    initRevealScene();
  } else {
    window.addEventListener("load", initRevealScene);
  }
</script>
