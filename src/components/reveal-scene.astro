---
// src/components/reveal-scene.astro
---

<section class="scrollytelling-scene relative z-10" id="reveal" aria-label="Creative philosophy">
  <div class="pin-container">
    <div class="split-text">
      <span class="text-left">CODE</span>
      <div class="image-mask">
        <img
          src="/me02.png"
          alt="Emiliano Montes"
          class="w-full h-full object-cover object-[center_20%]"
          loading="lazy"
          decoding="async"
        />
      </div>
      <span class="text-right">BEAUTY</span>
    </div>
    <p class="pin-caption absolute bottom-[8vh] text-center font-mono text-sm md:text-base max-w-[45ch] z-10 will-change-[transform,opacity] opacity-0" style="color: var(--text-muted);">
        I make it work. Then I make it feel right.
    </p>
  </div>
</section>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  function initRevealScene() {
    gsap.registerPlugin(ScrollTrigger);

    const pinScene = document.querySelector(".scrollytelling-scene");
    if (!pinScene) return;

    const tl = gsap.timeline({
      scrollTrigger: {
        trigger: pinScene,
        start: "top top",
        end: "+=220%",      // More scroll real estate = slower, more controlled reveal
        scrub: 1,           // Heavier lag feels editorial and mechanical
        pin: true,
        pinSpacing: true,
        anticipatePin: 1,
      }
    });

    // Phase 1 (0 → 1.6): Clip expands + texts split + image scales in
    tl.fromTo(".image-mask",
      { clipPath: "inset(38% 46% 38% 46%)" },   // Tighter start = more dramatic punch
      { clipPath: "inset(0% 0% 0% 0%)", duration: 1.6, ease: "power2.inOut" },
      0
    )
    .fromTo(".bg-image-liquid",
      { scale: 1.6 },
      { scale: 1, duration: 1.6, ease: "power2.inOut" },
      0
    )
    // More extreme horizontal spread for hard editorial collision
    .fromTo(".text-left",
      { x: "0vw" },
      { x: "-38vw", duration: 1.6, ease: "power2.inOut" },
      0
    )
    .fromTo(".text-right",
      { x: "0vw" },
      { x: "38vw", duration: 1.6, ease: "power2.inOut" },
      0
    )

    // Phase 2 (1.6 → 2.0): Caption fades in
    .fromTo(".pin-caption",
      { opacity: 0, y: 16 },
      { opacity: 1, y: 0, duration: 0.5, ease: "power2.out" },
      1.6
    );

    // ── Parallax & Blur out on scroll into Track Record ─────────────────────
    gsap.to(".pin-container", {
      y: 100,
      opacity: 0,
      filter: "blur(8px)",
      ease: "none",
      scrollTrigger: {
        trigger: ".page-shell",
        start: "top bottom",
        end: "top 10%",
        scrub: true,
      }
    });
  }

  document.addEventListener("astro:page-load", initRevealScene);
  if (document.readyState === "complete") {
    initRevealScene();
  } else {
    window.addEventListener("load", initRevealScene);
  }
</script>
