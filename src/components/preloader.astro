---
// Preloader: counts 0 → 100 while fonts load and the hero WebGL draws its first
// frame, then wipes up and fires `app:ready` (hero entrance + Lenis start listen
// to it). Shown once per session; skipped entirely under reduced motion.
const year = new Date().getFullYear();
---

<div class="preloader" id="preloader" aria-hidden="true">
  <canvas class="preloader-dots" data-dots></canvas>
  <span class="preloader-meta"><b>Emiliano Montes</b><br />Portfolio {year}</span>
  <span class="preloader-meta">Loading</span>
  <span class="preloader-count"><span data-count>00</span></span>
</div>

<script>
  import { gsap } from "gsap";

  const SESSION_KEY = "preloader:shown";
  // Hard cap so a stalled WebGL context or a blocked font never traps the user.
  const HERO_TIMEOUT_MS = 2500;

  function initPreloader() {
    const el = document.getElementById("preloader");
    if (!el) return;

    const html = document.documentElement;
    const out = el.querySelector<HTMLElement>("[data-count]");
    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    let shown = false;
    try { shown = sessionStorage.getItem(SESSION_KEY) === "1"; } catch { /* private mode */ }

    const finish = () => {
      html.classList.remove("is-loading");
      el.remove();
      window.dispatchEvent(new CustomEvent("app:ready"));
    };

    if (reduce || shown) {
      finish();
      return;
    }

    html.classList.add("is-loading");
    try { sessionStorage.setItem(SESSION_KEY, "1"); } catch { /* ignore */ }

    const counter = { v: 0 };
    const render = () => {
      if (out) out.textContent = String(Math.round(counter.v)).padStart(2, "0");
    };

    // ── Halftone: a dot matrix resolves into the initials, then dissolves ──
    // Deterministic raster: text drawn to an offscreen canvas, sampled per cell.
    const dotsCanvas = el.querySelector<HTMLCanvasElement>("[data-dots]");
    const dots = dotsCanvas ? initHalftone(dotsCanvas, "EM") : null;
    const halftone = { assemble: 0, dissolve: 0 };
    const drawDots = () => dots?.draw(halftone.assemble, halftone.dissolve);

    const heroReady = new Promise<void>((resolve) => {
      const t = window.setTimeout(resolve, HERO_TIMEOUT_MS);
      window.addEventListener("hero:ready", () => { window.clearTimeout(t); resolve(); }, { once: true });
    });

    const tl = gsap.timeline();
    tl.to(counter, { v: 88, duration: 1.3, ease: "power2.inOut", onUpdate: render })
      .to(halftone, { assemble: 1, duration: 1.4, ease: "expo.out", onUpdate: drawDots }, 0);

    Promise.all([document.fonts.ready, heroReady]).then(() => {
      tl.to(counter, { v: 100, duration: 0.45, ease: "power3.out", onUpdate: render })
        .to(halftone, { dissolve: 1, duration: 0.9, ease: "power2.in", onUpdate: drawDots }, "<")
        .to(el, { yPercent: -100, duration: 1.1, ease: "expo.inOut" }, "+=0.05")
        // Release scroll + start the hero while the curtain is still leaving.
        .call(() => {
          html.classList.remove("is-loading");
          window.dispatchEvent(new CustomEvent("app:ready"));
        }, undefined, "-=0.7")
        .call(() => el.remove());
    });
  }

  // Samples `text` into a grid of cells; each dot grows from a scattered seed
  // (assemble 0→1) and shrinks away left-to-right (dissolve 0→1).
  function initHalftone(canvas: HTMLCanvasElement, text: string) {
    const dpr = Math.min(window.devicePixelRatio || 1, 2);
    const W = window.innerWidth, H = window.innerHeight;
    canvas.width = W * dpr; canvas.height = H * dpr;
    const ctx = canvas.getContext("2d")!;
    ctx.scale(dpr, dpr);

    const cell = Math.max(10, Math.round(Math.min(W, H) / 48));
    const cols = Math.ceil(W / cell), rows = Math.ceil(H / cell);
    const off = document.createElement("canvas");
    off.width = cols; off.height = rows;
    const octx = off.getContext("2d")!;
    octx.fillStyle = "#000"; octx.fillRect(0, 0, cols, rows);
    octx.fillStyle = "#fff";
    octx.font = `700 ${Math.round(rows * 0.62)}px Geist, system-ui, sans-serif`;
    octx.textAlign = "center"; octx.textBaseline = "middle";
    octx.fillText(text, cols / 2, rows / 2 + rows * 0.02);
    const data = octx.getImageData(0, 0, cols, rows).data;

    const seeds: number[] = [];
    for (let i = 0; i < cols * rows; i++) seeds.push(Math.random());

    const draw = (assemble: number, dissolve: number) => {
      ctx.clearRect(0, 0, W, H);
      ctx.fillStyle = "#1a1a1a";
      for (let r = 0; r < rows; r++) {
        for (let c = 0; c < cols; c++) {
          const i = r * cols + c;
          const lum = data[i * 4] / 255;               // 1 inside the letters
          const base = 0.08 + lum * 0.42;              // dot radius as a fraction of the cell
          const seed = seeds[i];
          // scattered start: dots arrive with a per-cell delay
          const a = Math.min(1, Math.max(0, (assemble - seed * 0.5) / 0.5));
          // dissolve sweeps left → right
          const sweep = Math.min(1, Math.max(0, (dissolve * 1.3 - c / cols) / 0.3));
          const radius = cell * base * a * (1 - sweep);
          if (radius < 0.3) continue;
          const jitter = (1 - a) * cell * 0.6 * (seed - 0.5);
          ctx.beginPath();
          ctx.arc(c * cell + cell / 2 + jitter, r * cell + cell / 2 - jitter, radius, 0, Math.PI * 2);
          ctx.fill();
        }
      }
    };
    draw(0, 0);
    return { draw };
  }

  document.addEventListener("astro:page-load", initPreloader);
  if (document.readyState === "complete") {
    initPreloader();
  } else {
    window.addEventListener("load", initPreloader);
  }
</script>
