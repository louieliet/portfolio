---
import type { GetStaticPaths } from 'astro';
import { existsSync } from 'node:fs';
import Layout from '../../layouts/Layout.astro';
import Media from '../../components/Media.astro';
import CaseMeta from '../../components/CaseMeta.astro';
import CaseSection from '../../components/CaseSection.astro';
import CaseOutcome from '../../components/CaseOutcome.astro';
import NextProject from '../../components/NextProject.astro';
import { projects, type ProjectItem } from '@/lib/data';

export const getStaticPaths = (() => {
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}) satisfies GetStaticPaths;

const { project } = Astro.props;
// Heavy covers get a 1200x630 crop in public/projects/og/ when one exists (WhatsApp skips multi-MB images).
const ogPath = `/projects/og/${project.id}.jpg`;
const hasOgCrop = existsSync(new URL(`../../../public${ogPath}`, import.meta.url));
// WhatsApp and Facebook do not render SVG og:images, so svg covers fall back to the default /og.jpg.
const cover = project.images?.[0];
const coverImage = cover && !cover.endsWith(".svg") ? cover : undefined;

// Typed view of the static data (data.ts is inferred as plain strings).
const item = project as ProjectItem;
const allProjects = projects as ProjectItem[];
const nextIndex = allProjects.findIndex((p) => p.id === item.id) + 1;
const next = allProjects[nextIndex % allProjects.length];

/*
 * Portrait hero rule (explicit, from project data):
 * - imageAspect "9/16" is a phone shot, always portrait.
 * - Mobile projects show a phone still in the hero unless their cover is 16:9.
 * Portrait heroes are capped in height on a tinted band; everything else runs full bleed.
 */
function isPortraitHero(p: ProjectItem): boolean {
  if (p.imageAspect === "9/16") return true;
  return p.category === "Mobile" && p.coverAspect !== "16/9";
}

const heroSrc = item.heroShot ?? item.images?.[0];
const portrait = isPortraitHero(item);

// Screens gallery: images beyond the cover that neither the hero nor a section already shows.
const usedInSections = new Set<string>((item.sections ?? []).flatMap((s) => s.media?.images ?? []));
const gallery = (item.images ?? []).slice(1).filter((src) => src !== heroSrc && !usedInSections.has(src));

const mascot = item.mascot;
const alt = `${item.name} cover`;
---

<Layout
  title={`${project.name} | Projects`}
  description={project.description}
  image={hasOgCrop ? ogPath : coverImage}
  imageAlt={`${project.name} cover`}
  imageWidth={hasOgCrop ? 1200 : undefined}
  imageHeight={hasOgCrop ? 630 : undefined}
>
  <article class="case-page">
    <div class="col case-head">
      <p class="t-mono muted">{item.category} / {item.year}</p>
      <div class="title-row">
        <h1 class="t-display" data-roll="slow" data-arrive="0">{item.name}</h1>
        {
          mascot && (
            <video
              class="mascot"
              autoplay
              muted
              loop
              playsinline
              aria-hidden="true"
              poster={mascot.poster}
              data-case-mascot
            >
              <source src={mascot.mov} type='video/quicktime; codecs="hvc1"' />
              <source src={mascot.webm} type="video/webm" />
            </video>
          )
        }
      </div>
      <p class="t-lead description" data-roll data-arrive="0.15">{item.description}</p>
    </div>

    <CaseMeta project={item} />

    {
      heroSrc && (
        <div class:list={['bleed', 'hero', 'reveal', portrait ? 'hero--portrait' : 'hero--wide']} data-arrive="0.5">
          {portrait ? (
            <div class="hero-band">
              <Media
                class="hero-phone"
                src={heroSrc}
                alt={alt}
                loading="eager"
                transitionName={`cover-${item.id}`}
              />
            </div>
          ) : (
            <Media
              class="hero-wide"
              src={heroSrc}
              alt={alt}
              loading="eager"
              transitionName={`cover-${item.id}`}
            />
          )}
        </div>
      )
    }

    <div class="col overview">
      <p>{item.overview}</p>
      <p class="muted">{item.focus}</p>
    </div>

    {(item.sections ?? []).map((s, i) => (
      <CaseSection section={s} index={i} projectName={item.name} />
    ))}

    {
      gallery.length > 0 && (
        <div class="bleed gallery" role="region" aria-label="Screens" tabindex="0">
          {gallery.map((src, i) => (
            <Media
              class="gallery-item"
              src={src}
              alt={`${item.name} screen ${i + 1} of ${gallery.length}`}
              loading="lazy"
            />
          ))}
        </div>
      )
    }

    <CaseOutcome project={item} />
    <NextProject project={next} />

    <a class="back t-mono" href="/#work" data-case-back data-no-inl>
      <svg width="14" height="14" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        <path
          d="M19 12H5M11 6l-6 6 6 6"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        />
      </svg>
      <span data-swap>Back</span>
    </a>
  </article>
</Layout>

<style>
  .case-head {
    padding-top: 96px;
  }

  .title-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 24px;
    margin-top: 16px;
  }

  .mascot {
    flex: none;
    width: auto;
    height: 72px;
  }

  .description {
    margin-top: 24px;
  }

  .hero {
    margin-top: clamp(48px, 8vh, 96px);
  }

  .hero--portrait {
    padding-inline: 0;
  }

  .hero--wide {
    padding-inline: 0;
  }

  /* Portrait phone shot: capped height, centred on a faint band. max-width keeps any landscape still inside the band. */
  .hero-band {
    display: flex;
    justify-content: center;
    padding: clamp(32px, 6vh, 64px) clamp(20px, 3vw, 48px);
    background: color-mix(in srgb, var(--text) 4%, transparent);
  }

  .hero-band .hero-phone {
    width: auto;
    max-width: 100%;
    max-height: 80vh;
    height: auto;
  }

  .hero-wide {
    width: 100%;
    max-height: 86vh;
    object-fit: cover;
  }

  .overview {
    padding-block: clamp(56px, 8vh, 96px);
  }

  .overview p + p {
    margin-top: 16px;
  }

  .gallery {
    display: flex;
    gap: 16px;
    height: clamp(320px, 60vh, 640px);
    margin-top: clamp(56px, 8vh, 96px);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
  }

  .gallery .gallery-item {
    flex: none;
    width: auto;
    height: 100%;
    scroll-snap-align: start;
  }

  .back {
    position: fixed;
    left: 50%;
    bottom: 24px;
    z-index: 50;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 10px 16px;
    background: var(--text);
    color: var(--bg);
    text-decoration: none;
    transform: translateX(-50%);
    transition:
      opacity 300ms var(--ease-out),
      visibility 300ms;
  }

  .back.is-hidden {
    opacity: 0;
    pointer-events: none;
    visibility: hidden;
  }

  @media (max-width: 719px) {
    .case-head {
      padding-top: 72px;
    }

    .mascot {
      height: 56px;
    }
  }
</style>

<script>
  /*
   * Case page behaviour, re-run on every client navigation.
   * - Mascot: autoplays, but stays on its poster under reduced motion.
   * - Back link: hidden while the site footer is on screen.
   * Every lookup is guarded, because this listener stays registered after leaving a case page.
   */
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
  let footerObserver: IntersectionObserver | null = null;

  function setup(): void {
    footerObserver?.disconnect();
    footerObserver = null;

    if (reduceMotion.matches) {
      document.querySelectorAll<HTMLVideoElement>('video[data-case-mascot]').forEach((video) => video.pause());
    }

    const back = document.querySelector<HTMLElement>('[data-case-back]');
    const footer = document.querySelector('footer');
    if (!back || !footer || !('IntersectionObserver' in window)) return;

    footerObserver = new IntersectionObserver(
      ([entry]) => {
        back.classList.toggle('is-hidden', entry.isIntersecting);
      },
      { threshold: 0 },
    );
    footerObserver.observe(footer);
  }

  document.addEventListener('astro:page-load', setup);
  document.addEventListener('astro:before-swap', () => {
    footerObserver?.disconnect();
    footerObserver = null;
  });
</script>
