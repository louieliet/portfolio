---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import Story from '../components/Story.astro';
import WorkStack from '../components/WorkStack.astro';
import Approach from '../components/Approach.astro';
import Timeline from '../components/Timeline.astro';
import { experience } from '../lib/data';
---

<Layout>
  <Hero />
  <!-- How I work: pinned chapter between the hero and the work (the ASCII field carries over). -->
  <div class="col">
    <Story />
  </div>
  <WorkStack />
  <Approach />
  <div class="col section">
    <Timeline items={experience} heading="Experience" detailed={false} />
  </div>
</Layout>
