---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/hero.astro';
import RevealScene from '../components/reveal-scene.astro';
import Experience from '../components/experience';
import Projects from '../components/projects';
import About from '../components/about.astro';
import Contact from '../components/contact.astro';
---

<Layout>
  <!-- Full-bleed Sticky Hero -->
  <Hero />

  <!-- Scrollytelling Scene (Outside page-shell for full bleed clipping) -->
  <RevealScene />

  <!-- Constrained Content sliding over the Hero/Reveal -->
  <main class="page-shell relative z-10 min-h-screen border-t brutalist-border shadow-[0_-20px_50px_rgba(0,0,0,0.2)]">
    <Experience client:load />
    <Projects client:load />
    <About />
    <Contact />
  </main>
</Layout>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  function initThemeToggle() {
    const pageShell = document.querySelector(".page-shell");
    if (!pageShell) return;

    ScrollTrigger.create({
      trigger: pageShell,
      start: "top 30%", // When the page-shell covers 70% of the screen
      end: "bottom bottom",
      onEnter: () => document.body.classList.add("theme-light"),
      onLeaveBack: () => document.body.classList.remove("theme-light"),
    });
  }

  document.addEventListener("astro:page-load", initThemeToggle);
  if (document.readyState === "complete") {
    initThemeToggle();
  } else {
    window.addEventListener("load", initThemeToggle);
  }
</script>
