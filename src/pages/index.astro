---
import Layout from '../layouts/Layout.astro';
import Curtain from '../components/Curtain.astro';
import Hero from '../components/Hero.astro';
import Story from '../components/Story.astro';
import WorkStack from '../components/WorkStack.astro';
import Experience from '../components/Experience.astro';
import { homeJsonLd } from '../lib/seo';
---

<Layout jsonLd={homeJsonLd()}>
  <!-- Full-screen ASCII cover, first in the markup so it is on the first paint. It opens the home page's arrivals. -->
  <Curtain />
  <Hero />
  <!-- How I work: pinned chapter between the hero and the work (the ASCII field carries over). -->
  <div class="col">
    <Story />
  </div>
  <WorkStack />
  <div class="col">
    <Experience />
  </div>
</Layout>
